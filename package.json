{
  "name": "rebirth-minigame",
  "type": "2d",
  "uuid": "75149d21-71fa-4c3c-8c1d-88c5c360815f",
  "version": "1.0.0",
  "creator": {
    "version": "3.8.0"
  },
  "private": true,
  "description": "这一世我重生了 - 微信小游戏",
  "scripts": {
    "art": "node tools/art/gen-art.mjs",
    "art:check": "python3 tools/art/check_art.py",
    "audio": "python3 tools/audio/gen_audio.py",
    "share": "python3 tools/share/gen_share.py",
    "preplay": "node tools/ensure-cocos-temp.mjs",
    "play": "tsx tools/play.ts",
    "postinstall": "node tools/ensure-cocos-temp.mjs",
    "presim": "node tools/ensure-cocos-temp.mjs",
    "sim": "tsx tools/play.ts --sim 2000",
    "prerarity": "node tools/ensure-cocos-temp.mjs",
    "rarity": "tsx tools/play.ts --sim 100 --rarity",
    "pretest": "node tools/ensure-cocos-temp.mjs",
    "test": "vitest run",
    "lines": "tsx tools/lines.ts",
    "ui:snap": "vitest run -c vitest.ui.config.ts && node tools/ui-snap/render.mjs",
    "pretypecheck": "node tools/ensure-cocos-temp.mjs",
    "typecheck": "tsc -p tsconfig.tools.json && tsc -p tsconfig.game.json",
    "prevalidate": "node tools/ensure-cocos-temp.mjs",
    "validate": "tsx tools/validate.ts",
    "persona": "tsx tools/persona.ts",
    "share:snap": "tsx tools/share/snap.ts",
    "story": "tsx tools/story.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
