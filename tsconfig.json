{
  /* Base configuration. Do not edit this field. */
  "extends": "./temp/tsconfig.cocos.json",

  /* Add your custom configuration here. */
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true
  },
  /* typings/ 是 Linux 端类型检查用的 cc 替身，不能让编辑器看到；tests/ tools/ 是 Node 端脚本 */
  "exclude": ["node_modules", "library", "temp", "local", "build", "profiles", "typings", "tests", "tools"]
}
