[
  {
    "id": "m_d3_pear", "dir": "down", "layers": ["D3"], "maps": ["orchard"], "weight": 14,
    "text": "这个梨里已经住了一窝果蝇，正围着烂掉的那一块开派对。",
    "choices": [
      { "text": "加入派对", "effect": { "饱腹": 3, "胃口": 1 }, "result": "你吃了一口发酵的梨，晕乎乎地跟着它们转了一夜圈。" },
      { "text": "把它们轰出去", "chance": 0.5, "chanceAttr": "胃口", "chanceStep": 0.06, "effect": { "胃口": 2, "蜕变": 4 }, "result": "你一口咬掉烂的那块。果蝇骂骂咧咧飞走了，梨归你了。", "easy": "你张嘴的一瞬间，果蝇已经搬完家了。", "fail": { "effect": { "饱腹": -1 }, "result": "果蝇太多，围着你嗡嗡转。你被吵得一口没吃下。" } },
      { "text": "前世饿怕了", "require": "legacy:big_belly>=1", "effect": { "饱腹": 4, "蜕变": 3 }, "result": "前世你饿瘪过。这一世你把梨吃成了空壳，果蝇只能搬家。" },
      { "text": "教它们排队", "absurd": true, "chance": 0.2, "chanceAttr": "灵性", "chanceStep": 0.03, "effect": { "灵性": 3, "蜕变": 8 }, "result": "果蝇真排好了队，一只一只来领梨汁。你成了梨里的管事。", "fail": { "effect": { "饱腹": -1 }, "result": "它们听不懂。它们只听得懂梨。" } }
    ]
  },
  {
    "id": "m_d3_seed", "dir": "down", "layers": ["D3"], "weight": 10,
    "text": "啃到果核，你听见核里有个细细的声音：外面下雨了吗？我想出去。",
    "choices": [
      { "text": "帮它啃开核", "effect": { "胃口": 1, "灵性": 2, "follow": { "id": "m_f_sprout", "delay": 2, "ttl": 6 } }, "result": "你啃了半天，核裂开一条缝。种子说：谢谢，我记住你了。" },
      { "text": "把核滚出果子", "chance": 0.55, "chanceAttr": "攀爬", "chanceStep": 0.08, "effect": { "攀爬": 2, "蜕变": 3, "follow": { "id": "m_f_sprout", "delay": 3, "ttl": 6 } }, "result": "你推着核从洞口滚了出去，它落进了土里。", "fail": { "effect": { "饱腹": -2 }, "result": "核卡在洞口，你推了一季，累瘪了。" } },
      { "text": "说没下雨", "effect": { "灵性": 1, "饱腹": 1 }, "result": "种子说那它再睡会儿。核里传出很小的呼噜声。" }
    ]
  },
  {
    "id": "m_f_sprout", "dir": "any", "chainOnly": true, "teaser": "那颗种子说它记住你了",
    "text": "你啃开过的那颗核发芽了。两片小叶子摊开，叶面上有一颗露珠，像特意留的。",
    "choices": [
      { "text": "喝那颗露珠", "effect": { "饱腹": 2, "灵性": 2, "蜕变": 3 }, "result": "露珠是甜的。小苗晃了晃，像在点头。" },
      { "text": "替它赶走蜗牛", "chance": 0.6, "chanceAttr": "吐丝", "chanceStep": 0.08, "effect": { "吐丝": 2, "蜕变": 5 }, "result": "你用丝把蜗牛绊了个跟头。小苗长出了第三片叶子。", "fail": { "effect": { "饱腹": -1 }, "result": "蜗牛不理你，啃了它一片叶子。你心疼了一季。" } },
      { "text": "啃它一口", "effect": { "饱腹": 3, "灵性": -1 }, "result": "小苗没说话。那一季，没有一颗露珠是给你的。" }
    ]
  },
  {
    "id": "m_d3_chili", "dir": "down", "layers": ["D3"], "maps": ["veg"], "weight": 14,
    "text": "你钻进一根红果子，咬一口，脑袋轰的一声——是辣椒。老太太正挨个摘辣椒。",
    "choices": [
      { "text": "忍着吃完", "chance": 0.45, "chanceAttr": "胃口", "chanceStep": 0.06, "effect": { "胃口": 3, "蜕变": 5 }, "result": "你辣得满身毛都竖起来了，但吃完了。整个菜园数你能吃辣。", "fail": { "effect": { "饱腹": -2 }, "result": "你辣得爬出来找水，在叶子上趴了一天。" } },
      { "text": "赶紧钻出来", "effect": { "饱腹": -1, "攀爬": 1 }, "result": "你爬出来，换了一棵白菜。白菜真好。" },
      { "text": "前世被捏走过", "require": "legacy:wary>=1", "effect": { "灵性": 2, "饱腹": 2, "蜕变": 3 }, "result": "前世你被这样的手捏走过。这一世她还没到，你已经换了一根。" }
    ]
  },
  {
    "id": "m_d4_mole", "dir": "down", "layers": ["D4"], "stage": [1, 99], "weight": 12,
    "text": "土里拱过来一只鼹鼠，鼻子粉红，眼睛几乎看不见。它问你：这是往哪儿？",
    "choices": [
      { "text": "给它指路", "effect": { "灵性": 2, "follow": { "id": "m_f_mole_tunnel", "delay": 2 } }, "result": "你说往左。它说谢谢，往右挖走了。" },
      { "text": "搭它的顺风车", "chance": 0.5, "chanceAttr": "攀爬", "chanceStep": 0.06, "effect": { "攀爬": 2, "胃口": 2, "蜕变": 4 }, "result": "你扒在它背上穿过三条树根。地底下原来有这么多路。", "fail": { "effect": { "饱腹": -2 }, "result": "它一甩头，你被甩进土堆里，扒了一天才出来。" } },
      { "text": "跟它聊聊", "showIf": "skill:talk", "useSkill": "talk", "effect": { "灵性": 3, "蜕变": 5, "follow": { "id": "m_f_mole_tunnel", "delay": 2 } }, "result": "它说它看不见，但地底下哪儿甜，它都知道。" }
    ]
  },
  {
    "id": "m_f_mole_tunnel", "dir": "down", "chainOnly": true, "teaser": "鼹鼠说要请你吃饭",
    "text": "鼹鼠又拱来了：上回你指错路，我倒挖到一窝甜根。走，请你。",
    "choices": [
      { "text": "跟它去", "effect": { "饱腹": 3, "胃口": 2, "蜕变": 4 }, "result": "甜根一节一节，像埋在土里的糖。你们吃到天亮。" },
      { "text": "不去了", "effect": { "饱腹": 2, "灵性": 1 }, "result": "它说那给你留一节。第二天，你窝边真多了一节根。" },
      { "text": "认它当坐骑", "absurd": true, "chance": 0.2, "chanceAttr": "灵性", "chanceStep": 0.03, "effect": { "攀爬": 3, "灵性": 3, "蜕变": 8 }, "result": "它答应了。从此树根底下多了一条骑鼹鼠的虫。", "fail": { "effect": { "饱腹": -1 }, "result": "它说它只驮自家孩子。你被礼貌地放了下来。" } }
    ]
  },
  {
    "id": "m_d4_amber", "dir": "down", "layers": ["D4"], "stage": [2, 99], "weight": 6, "gold": true, "once": true,
    "text": "树根缝里卡着一块黄澄澄的石头。里面封着一只蝴蝶，翅膀还张着。",
    "choices": [
      { "text": "盯着它看一季", "effect": { "灵性": 3, "蜕变": 8 }, "result": "那只蝴蝶的花纹，和你梦里见过的一样。你记住了每一条。" },
      { "text": "啃一口试试", "absurd": true, "chance": 0.15, "chanceAttr": "胃口", "chanceStep": 0.02, "effect": { "胃口": 2, "蜕变": 20 }, "result": "你啃下一点渣。肚子里暖了三天，背上冒出一点金粉。", "fail": { "effect": { "饱腹": -1 }, "result": "硌牙。它在一万年前就不打算被吃了。" } },
      { "text": "前世睡过了头", "require": "legacy:patience>=1", "effect": { "灵性": 3, "蜕变": 12 }, "result": "前世你在茧里睡过头。这一世你看懂了：它也是没醒的那一只。" }
    ]
  },
  {
    "id": "m_u1_larva", "dir": "up", "layers": ["U1"], "weight": 12,
    "text": "叶尖上趴着一只黑乎乎的小东西，背上有刺，像条小鳄鱼。它说它将来会很好看。",
    "choices": [
      { "text": "你也会的", "effect": { "灵性": 2, "follow": { "id": "m_f_ladybird", "delay": 3, "ttl": 6 } }, "result": "它说那咱们比比，看谁变得更好看。" },
      { "text": "跟它比爬叶尖", "chance": 0.55, "chanceAttr": "攀爬", "chanceStep": 0.08, "effect": { "攀爬": 2, "蜕变": 3 }, "result": "你先到了叶尖。它说下回它有翅膀，就不比这个了。", "fail": { "effect": { "饱腹": -1 }, "result": "它六条腿，你一节一节。你输了。" } },
      { "text": "笑它丑", "effect": { "攀爬": 1 }, "result": "它看了看你，说：你也没好到哪儿去。你们各自爬开了。" }
    ]
  },
  {
    "id": "m_f_ladybird", "dir": "any", "chainOnly": true, "teaser": "那个丑东西说要回来比美",
    "text": "一只红壳七个点的瓢虫落在你面前，转了一圈：认得我吗？我说过我会好看。",
    "choices": [
      { "text": "认得", "effect": { "灵性": 2, "蜕变": 4 }, "result": "它在你背上停了一会儿，替你吃掉了三只蚜虫。" },
      { "text": "跟它比好看", "absurd": true, "chance": 0.25, "chanceAttr": "灵性", "chanceStep": 0.03, "effect": { "灵性": 3, "蜕变": 8 }, "result": "它看了你很久，说：等你出茧再比。它说这是认输。", "fail": { "effect": { "灵性": 1 }, "result": "它说你现在是条虫。你没法反驳。" } },
      { "text": "装作不认得", "effect": { "饱腹": 1 }, "result": "它说没关系，它会记得你。说完飞走了。" }
    ]
  },
  {
    "id": "m_u1_kite", "dir": "up", "layers": ["U1"], "maps": ["park"], "weight": 14,
    "text": "一根风筝线缠在了叶尖上，另一头连着天上的风筝。风一扯，整片叶子跟着晃。",
    "choices": [
      { "text": "抓紧叶子", "effect": { "攀爬": 1, "饱腹": 1 }, "result": "叶子晃了一下午。你晃晕了，但没掉。" },
      { "text": "顺着线往上爬", "chance": 0.4, "chanceAttr": "攀爬", "chanceStep": 0.06, "effect": { "攀爬": 3, "蜕变": 5 }, "result": "你爬了一大截线，看见了整个公园。小孩指着天：风筝上有虫！", "fail": { "effect": { "饱腹": -2 }, "result": "线一抖，你掉回了草里。" } },
      { "text": "前世被雨冲过", "require": "legacy:grip>=1", "effect": { "攀爬": 3, "灵性": 2, "蜕变": 3 }, "result": "前世你从树上被冲下去过。这一世风再扯，你的脚也不松。" },
      { "text": "把线咬断", "absurd": true, "chance": 0.25, "chanceAttr": "胃口", "chanceStep": 0.04, "effect": { "胃口": 2, "灵性": 1, "蜕变": 8 }, "result": "线断了。风筝晃悠悠飞向天边，自由了。你也觉得很自由。", "fail": { "effect": { "饱腹": -1 }, "result": "线比你的牙硬。你啃了一季，啃出一嘴线头。" } }
    ]
  },
  {
    "id": "m_u2_woodpecker", "dir": "up", "layers": ["U2"], "maps": ["orchard"], "stage": [1, 99], "weight": 14,
    "text": "树干里传来笃笃笃的声音，越来越近。一只啄木鸟正一路敲过来，听哪儿是空的。",
    "choices": [
      { "text": "一动不动", "effect": { "灵性": 2 }, "result": "敲击声在你旁边停了很久，然后走了。你一根毛都没敢抖。" },
      { "text": "钻进树皮缝", "chance": 0.55, "chanceAttr": "攀爬", "chanceStep": 0.08, "effect": { "攀爬": 2, "蜕变": 3 }, "result": "你挤进了树皮缝。它敲了两下，听出是实心的，走了。", "fail": { "effect": { "death": "bird" }, "result": "缝太浅了。笃。" } },
      { "text": "前世被鸟叼过", "require": "legacy:camouflage>=1", "effect": { "灵性": 2, "蜕变": 5 }, "result": "前世你被鸟叼走过。这一世你趴在树皮上，颜色和树皮一模一样。" },
      { "text": "给它指天牛的洞", "absurd": true, "chance": 0.2, "chanceAttr": "灵性", "chanceStep": 0.03, "effect": { "灵性": 3, "蜕变": 8, "feud": "替天牛叫了一回啄木鸟" }, "result": "你冲树洞里的天牛努努嘴。啄木鸟道了声谢，咚咚开工。", "fail": { "effect": { "饱腹": -2 }, "result": "它看看树洞，又看看你。还是你比较近。你跑掉了半身毛。" } }
    ]
  },
  {
    "id": "m_u2_rainbow", "dir": "up", "layers": ["U2"], "stage": [1, 99], "weight": 6, "gold": true, "once": true,
    "text": "雨刚停，一道彩虹的一头正好落在你这根树枝上，一层一层，近得能摸到。",
    "choices": [
      { "text": "爬进去", "effect": { "灵性": 3, "蜕变": 12 }, "result": "你在红色那层趴了一会儿，又爬到紫色那层。背上多了一道颜色。" },
      { "text": "吐丝把它拴住", "absurd": true, "chance": 0.2, "chanceAttr": "吐丝", "chanceStep": 0.03, "effect": { "吐丝": 3, "蜕变": 20 }, "result": "你拴住了一截彩虹，它在你丝上挂了一整天才散。", "fail": { "effect": { "吐丝": 1 }, "result": "丝穿过去了。彩虹没意见，也没留下。" } },
      { "text": "喊点点来看", "showIf": "companion:ladybug", "effect": { "灵性": 4, "蜕变": 10 }, "result": "点点趴在你旁边看。它说它的红壳，原来是从这儿掉下来的。" }
    ]
  },
  {
    "id": "m_u3_cuckoo", "dir": "up", "layers": ["U3"], "stage": [1, 99], "weight": 10,
    "text": "鸟窝里有一颗蛋特别大，颜色也不一样。鸟妈妈不在，那颗蛋先裂开了。",
    "choices": [
      { "text": "赶紧走", "effect": { "攀爬": 1, "灵性": 1 }, "result": "你走了。身后的窝里，有一颗小蛋被挤到了窝边。你没回头。" },
      { "text": "把小蛋护住", "chance": 0.4, "chanceAttr": "吐丝", "chanceStep": 0.06, "effect": { "吐丝": 2, "灵性": 3, "蜕变": 5 }, "result": "你吐丝把小蛋缠在窝底。那只大雏鸟推了三次，没推动。", "fail": { "effect": { "饱腹": -2 }, "result": "大雏鸟一挤，你被挤出窝外，挂在树枝上晃了半天。" } },
      { "text": "等鸟妈妈回来", "showIf": "skill:talk", "useSkill": "talk", "effect": { "灵性": 4, "蜕变": 6 }, "result": "你把看见的全告诉了它。它盯着那只大雏鸟，看了很久。" }
    ]
  },
  {
    "id": "m_u4_balloon", "dir": "up", "layers": ["U4"], "maps": ["park"], "stage": [1, 99], "weight": 14,
    "text": "一只红气球挂在了树顶，绳子垂下来，在你面前晃。远处有个小孩一直在看这边。",
    "choices": [
      { "text": "看着它", "effect": { "灵性": 1, "攀爬": 1 }, "result": "气球晃了一下午，傍晚自己挣开飞走了。小孩冲它挥手。" },
      { "text": "把绳结咬松", "chance": 0.5, "chanceAttr": "吐丝", "chanceStep": 0.08, "effect": { "吐丝": 2, "灵性": 3, "蜕变": 4 }, "result": "绳结一松，气球往下一沉。小孩跳起来，一把抓住了。", "fail": { "effect": { "饱腹": -1 }, "result": "结太死，你啃了一季，只啃松了一半。" } },
      { "text": "抱着绳子飞", "absurd": true, "chance": 0.2, "chanceAttr": "攀爬", "chanceStep": 0.03, "effect": { "攀爬": 3, "灵性": 2, "蜕变": 10 }, "result": "气球挣开树枝，带着你飘过半个公园，落在了花坛里。", "fail": { "effect": { "饱腹": -2 }, "result": "气球挣开时你还没抓牢。你从树顶一路滑回了枝头。" } }
    ]
  },
  {
    "id": "m_d1_heart", "dir": "down", "layers": ["D1"], "weight": 12,
    "text": "你和另一条虫从两边啃同一片叶子，啃到中间，叶子上多了一个心形的洞。",
    "choices": [
      { "text": "继续啃", "effect": { "饱腹": 2, "胃口": 1 }, "result": "心形没了，变成一个大洞。那条虫冲你点点头，走了。" },
      { "text": "留着这个洞", "effect": { "灵性": 2, "蜕变": 3 }, "result": "第二天，有人举着手机对这片叶子拍了半天。" },
      { "text": "抢它那半边", "chance": 0.5, "chanceAttr": "胃口", "chanceStep": 0.06, "effect": { "胃口": 2, "饱腹": 3 }, "result": "你吃得快，把它那半边也吃了。心形变成了月牙。", "fail": { "effect": { "饱腹": -1 }, "result": "它比你还能吃。最后只剩个叶柄，你们俩对着发呆。" } },
      { "text": "跟它结拜", "absurd": true, "chance": 0.3, "chanceAttr": "灵性", "chanceStep": 0.03, "effect": { "灵性": 3, "蜕变": 6 }, "result": "你们碰了碰触角，结拜了。它说以后有好叶子，先喊你。", "fail": { "effect": { "灵性": 1 }, "result": "它说它将来是飞蛾，不跟蝴蝶结拜。" } }
    ]
  },
  {
    "id": "m_d2_eggs", "dir": "down", "layers": ["D2"], "weight": 12,
    "text": "叶背上贴着一排小小的卵，一只蝴蝶在旁边扇着翅膀：我得走了，帮我看着它们。",
    "choices": [
      { "text": "答应它", "effect": { "灵性": 2, "follow": { "id": "m_f_hatch", "delay": 2, "ttl": 5 } }, "result": "蝴蝶飞走了。你在那排卵旁边趴下，一季没挪窝。" },
      { "text": "替它们赶蚂蚁", "chance": 0.5, "chanceAttr": "吐丝", "chanceStep": 0.08, "effect": { "吐丝": 2, "蜕变": 4, "follow": { "id": "m_f_hatch", "delay": 2, "ttl": 5 } }, "result": "一只蚂蚁来探路，你用丝把它绊了个跟头。它没再来。", "fail": { "effect": { "饱腹": -2 }, "result": "蚂蚁把你当成了卵，往回拖了一截。你挣开了，累得够呛。" } },
      { "text": "前世被蚂蚁搬过", "require": "legacy:ant_truce>=1", "effect": { "灵性": 3, "蜕变": 5, "follow": { "id": "m_f_hatch", "delay": 2, "ttl": 5 } }, "result": "前世蚂蚁搬走过你。这一世你跟它们说好，这排卵不算吃的。" },
      { "text": "我自己都顾不上", "effect": { "饱腹": 2 }, "result": "你爬去了别的叶子。走之前，你还是回头看了一眼。" }
    ]
  },
  {
    "id": "m_f_hatch", "dir": "down", "chainOnly": true, "teaser": "那排卵快孵了",
    "text": "那排卵一颗接一颗裂开，钻出来二十几条小虫，全冲着你叫：哥！",
    "choices": [
      { "text": "带它们吃叶子", "effect": { "饱腹": -1, "灵性": 3, "蜕变": 5 }, "result": "你领着一串小虫啃出一条路。它们啃得歪歪扭扭，你没骂。" },
