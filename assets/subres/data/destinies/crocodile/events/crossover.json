[
  {
    "id": "xo_grass_rock", "dir": "up", "layers": ["U1"], "cameo": true, "once": true, "weight": 10, "maps": ["river", "swamp"], "require": "xlives:desert_grass>=1",
    "text": "你晒背的石头缝里长着一株草，又瘦又倔。",
    "choices": [
      { "text": "给它挡太阳", "effect": { "灵性": 3, "龙气": 6 }, "result": "你挪了挪身子，替它挡住正午的太阳。前世，你也盼过有谁这样挡一下。" },
      { "text": "压着它晒", "effect": { "晒背": 2 }, "result": "草被你压弯了。你一走，它又直了起来。" }
    ]
  },
  {
    "id": "xo_grass_devourer", "dir": "down", "layers": ["D4"], "gold": true, "cameo": true, "once": true, "weight": 6, "require": "xend:desert_grass/devourer",
    "text": "龙渊底下伸上来一条黑色的树根，在你身边绕了一圈。",
