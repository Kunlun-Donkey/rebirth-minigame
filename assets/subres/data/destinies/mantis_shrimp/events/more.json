      { "text": "问白蟹是谁", "showIf": "skill:talk", "useSkill": "talk", "effect": { "灵性": 3, "海灵": 6 },
        "result": "白蟹说它们没见过太阳，也不想见。它们觉得你挺可怜。" },
      { "text": "往口子里看", "absurd": true, "chance": 0.15, "chanceAttr": "灵性", "chanceStep": 0.02,
        "effect": { "灵性": 4, "海灵": 15 }, "result": "口子里是一层一层的火。最底下，有什么东西翻了个身。",
        "fail": { "effect": { "death": "pressure" }, "result": "你探头往下看，水把你往下拽。再往下，就扁了。" } }
    ]
  },
  {
