    "text": "石头底下趴着一只海兔，又软又胖。你碰它一下，它喷出一团紫水，把自己藏了起来。",
    "choices": [
      { "text": "等它消气", "effect": { "灵性": 2, "体力": 1 }, "result": "紫水散了，它慢慢爬过来，挨着你一起躲退潮。" },
      { "text": "借点紫水", "chance": 0.55, "chanceAttr": "灵性", "chanceStep": 0.08,
        "effect": { "灵性": 2, "海灵": 4 }, "result": "你把紫水抹在壳上。赶海的人翻开石头，只看见一团紫。",
        "fail": { "effect": { "体力": -1 }, "result": "紫水糊了你一脸。你看什么都是紫的，看了一季。" } },
      { "text": "把石头顶翻", "absurd": true, "chance": 0.2, "chanceAttr": "拳力", "chanceStep": 0.02,
        "effect": { "拳力": 3, "海灵": 6 }, "result": "你一拳把石头顶翻了。海兔、螃蟹、小鱼，全看着你。",
        "fail": { "effect": { "体力": -2 }, "result": "石头比你重四百倍。它没动，你扁了一点。" } }
    ]
  },
  {
