        "fail": { "effect": { "体力": -2 }, "result": "它一拳把你打出了缝。它说：明天再来。" } },
      { "text": "把蛤蜊推过去", "showIf": "item:clam", "effect": { "loseItem": "clam", "灵性": 2, "海灵": 6 },
        "result": "它把蛤蜊打开，分了你一半。吃完，它又敲了一下墙。" }
    ]
  },
  {
    "id": "m_d2_squatter", "dir": "down", "layers": ["D2"], "weight": 10,
    "text": "你回洞一看，缝里多了一条鳚鱼，脑袋顶着两根小须，假装自己是块石头。",
    "choices": [
      { "text": "请它出去", "chance": 0.65, "chanceAttr": "拳力", "chanceStep": 0.08,
        "effect": { "拳力": 1, "打洞": 1 }, "result": "你一拳敲在旁边。那块石头长出鳍，飞快地游走了。",
        "fail": { "effect": { "体力": -1 }, "result": "它张嘴咬了你一口，又变回了石头。" } },
      { "text": "两家合住", "effect": { "灵性": 1, "体力": 1 }, "result": "它住前半截，你住后半截。有东西来，它先叫。" },
      { "text": "先敲三下墙", "require": "legacy:counter_punch>=1", "effect": { "打洞": 2, "灵性": 1 },
        "result": "前世螃蟹占了你的洞还夹你。这一世你先敲三下墙，鳚鱼自己搬了。" }
    ]
  },
  {
    "id": "m_d2_tooth", "dir": "down", "layers": ["D2"], "weight": 10,
    "text": "石缝里卡着一颗三角形的牙，比你的头还大。牙根上刻着一圈一圈的纹。",
    "choices": [
      { "text": "拿来磨钳子", "effect": { "拳力": 2, "体力": -1 }, "result": "你在牙上磨了一季钳子。磨完一挥，水里嗖的一声。" },
      { "text": "数那些纹", "effect": { "灵性": 2, "海灵": 3 }, "result": "纹一圈套一圈。这颗牙的主人，活得比礁石还久。" },
      { "text": "顺着牙往深挖", "chance": 0.5, "chanceAttr": "打洞", "chanceStep": 0.08,
        "effect": { "打洞": 3, "海灵": 4 }, "result": "牙后面还有一颗，再后面还有一颗。你决定不挖了。",
        "fail": { "effect": { "体力": -2 }, "result": "缝塌了一半。你被埋了一季，才把自己挖出来。" } }
    ]
  },
  {
