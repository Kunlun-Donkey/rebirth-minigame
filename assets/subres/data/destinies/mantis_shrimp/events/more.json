[
  {
    "id": "m_u1_mirror", "dir": "up", "layers": ["U1"], "weight": 10,
    "text": "浅水里沉着一块碎镜子。镜子里有只皮皮虾，冲你举起了拳头。",
    "choices": [
      { "text": "先下手为强", "effect": { "拳力": 2, "体力": -1 }, "result": "你一拳打过去，镜子裂成八瓣。八只虾都没还手，你赢麻了。" },
      { "text": "跟它比划", "effect": { "灵性": 2 }, "result": "你举左钳，它举右钳。比划了一下午，你发现它是你。" },
      { "text": "拉它入伙", "absurd": true, "chance": 0.2, "chanceAttr": "灵性", "chanceStep": 0.02,
        "effect": { "灵性": 3, "海灵": 8 }, "result": "你对着镜子练了一季拳。出拳快了一倍，镜子里那位也是。",
        "fail": { "effect": { "体力": -1 }, "result": "它学你点头，学你招手，就是不过来。你气得睡不着。" } }
    ]
  },
  {
    "id": "m_u1_bag", "dir": "up", "layers": ["U1"], "weight": 10,
    "text": "一个塑料袋在浅水里飘，鼓鼓囊囊的。一只小海龟正冲它张开嘴。",
    "choices": [
      { "text": "一拳打跑", "chance": 0.6, "chanceAttr": "拳力", "chanceStep": 0.08,
        "effect": { "拳力": 1, "灵性": 1, "海灵": 3 }, "result": "袋子被你打得翻着跟头漂远了。小海龟愣了半天，改咬海草。",
        "fail": { "effect": { "体力": -1 }, "result": "袋子把你整只裹了进去。你挣了半天才钻出来。" } },
      { "text": "拖去沙滩", "effect": { "游速": 2, "体力": -1 }, "result": "你把袋子拖上了沙滩。浪拍了几下，它再也回不来了。" },
      { "text": "请慢爷发话", "showIf": "companion:old_turtle", "effect": { "灵性": 2, "海灵": 4 },
        "result": "慢爷游过去，跟小海龟说：那玩意儿，我年轻时也咬过一回。" }
    ]
  },
  {
    "id": "m_u1_reef_parrot", "dir": "up", "layers": ["U1"], "maps": ["reef"], "weight": 12,
    "text": "一条鹦嘴鱼在啃珊瑚，嘎嘣嘎嘣。它游过去，身后飘下一串细白沙。",
    "choices": [
      { "text": "捡沙垫窝", "effect": { "打洞": 2 }, "result": "你用它拉的沙子垫了个新洞。又软又白，就是不能细想。" },
      { "text": "问它怎么做到的", "showIf": "skill:talk", "useSkill": "talk", "effect": { "灵性": 3, "海灵": 5 },
        "result": "它说这片沙滩，一半是它家祖传的。你重新看了一眼沙滩。" },
      { "text": "也啃一口珊瑚", "absurd": true, "chance": 0.2, "chanceAttr": "拳力", "chanceStep": 0.02,
        "effect": { "拳力": 3, "海灵": 8 }, "result": "你一拳敲下一块，嚼得嘎嘣响。鹦嘴鱼冲你点头：行家。",
        "fail": { "effect": { "体力": -2 }, "result": "珊瑚比你的嘴硬。你含着它，含了一季。" } }
    ]
  },

  {
    "id": "m_u2_flyingfish", "dir": "up", "layers": ["U2"], "weight": 10,
    "text": "一群飞鱼贴着海面冲过来，一条接一条蹦上了天。领头的冲你喊：上来！",
    "choices": [
      { "text": "看它们飞", "effect": { "灵性": 2, "follow": { "id": "m_c_flyingfish", "delay": 2 } },
        "result": "它们在天上滑了老远才落下。领头那条说，下回带你看个东西。" },
      { "text": "跟着冲刺", "chance": 0.55, "chanceAttr": "游速", "chanceStep": 0.06,
        "effect": { "游速": 2, "海灵": 3 }, "result": "你跟在后面冲了一段，尾巴甩得呼呼响。",
        "fail": { "effect": { "体力": -2 }, "result": "你冲得太猛，一头撞上了领头那条的屁股。" } },
      { "text": "跟它们一起飞", "absurd": true, "chance": 0.15, "chanceAttr": "游速", "chanceStep": 0.02,
        "effect": { "游速": 3, "灵性": 2, "海灵": 12 }, "result": "你蹦出水面，滑了三米。三米！飞得最远的皮皮虾。",
        "fail": { "effect": { "death": "seagull" }, "result": "你蹦得很高。海鸥接得很稳。" } }
    ]
  },
  {
    "id": "m_c_flyingfish", "dir": "up", "layers": ["U2", "U3", "U4"], "chainOnly": true,
    "teaser": "飞鱼说要带你看样东西",
    "text": "领头的飞鱼回来了：天上看得清，东边有一大片暖水，鱼多得挤不下。",
    "choices": [
      { "text": "去东边", "effect": { "游速": 1, "海灵": 6 }, "result": "你游了三天。那片水真是暖的，你吃胖了一圈。" },
      { "text": "让它再看看", "effect": { "灵性": 2, "体力": 2 }, "result": "它又飞了一趟，回来说东边有渔船。你决定在这儿待着。" },
      { "text": "咬住它尾巴", "require": "游速>=8", "effect": { "游速": 2, "海灵": 8 },
        "result": "你咬住它的尾巴，它飞起来了。你第一次看见了海的边。" }
    ]
  },
  {
    "id": "m_u2_slipper", "dir": "up", "layers": ["U2"], "weight": 10,
    "text": "海面上漂着一只拖鞋。一只小螃蟹坐在里面，拿钳子当桨，划得满头大汗。",
    "choices": [
      { "text": "在后面推", "effect": { "游速": 1, "灵性": 1 }, "result": "拖鞋跑得飞快。小螃蟹回头，冲你挥了挥钳子。" },
      { "text": "抢它的船", "chance": 0.5, "chanceAttr": "拳力", "chanceStep": 0.08,
        "effect": { "体力": 2, "游速": 2 }, "result": "你一拳把它请下了船。拖鞋很稳，你漂了一下午。",
        "fail": { "effect": { "体力": -1 }, "result": "它夹了你一下，划着拖鞋走了，边划边骂。" } },
      { "text": "搬家看中了", "showIf": "companion:hermit_crab", "effect": { "灵性": 2, "海灵": 4 },
        "result": "搬家盯着拖鞋两眼放光。小螃蟹拿船换了它一个螺壳。" }
    ]
  },
  {
    "id": "m_u2_market_kid", "dir": "up", "layers": ["U2"], "maps": ["market"], "weight": 12,
    "text": "一个小孩趴在水箱外头，拿手指一下一下敲玻璃：动一个！动一个！",
    "choices": [
      { "text": "沉到箱底", "effect": { "体力": 1 }, "result": "你不理他。他敲了一会儿，嫌没意思，被他妈拽走了。" },
      { "text": "隔着玻璃出拳", "chance": 0.5, "chanceAttr": "拳力", "chanceStep": 0.08,
        "effect": { "拳力": 2, "海灵": 4, "feud": "敲玻璃的小孩不敢敲了" }, "result": "砰的一声，玻璃上多了道白印。小孩缩回手，脸都白了。",
        "easy": "砰，玻璃裂了一道纹。老板跑过来时，小孩已经没影了。",
        "fail": { "effect": { "体力": -2 }, "result": "玻璃比你想的厚。你的钳子嗡嗡响了一下午。" } },
      { "text": "给他表演", "effect": { "灵性": 1, "体力": 2 }, "result": "你一拳打碎一个螺壳。小孩鼓掌，把手里的饼干渣撒了进来。" },
      { "text": "亮出尾刺", "require": "legacy:thorny_tail>=1", "effect": { "拳力": 1, "灵性": 2 },
        "result": "前世你在盘子边见过这样的小孩。这一世你冲他亮尾刺，他喊妈了。" }
    ]
  },

  {
    "id": "m_u3_bait", "dir": "up", "layers": ["U3"], "weight": 10,
    "text": "船边垂下一根钓线，钩上挂着一只虾仁。你认了半天，好像是远房表哥。",
    "choices": [
      { "text": "绕开走", "effect": { "灵性": 1 }, "result": "你绕了个大圈。表哥，一路走好。" },
      { "text": "把饵偷下来", "chance": 0.5, "chanceAttr": "拳力", "chanceStep": 0.06,
        "effect": { "体力": 3, "海灵": 3 }, "result": "你一钳子把饵拽下来，钩子空荡荡地晃。船上有人骂了一句。",
        "fail": { "effect": { "体力": -2 }, "result": "钩子一提，差点把你也带上去。你松钳松得很及时。" } },
      { "text": "把钩子打直", "showIf": "skill:punch", "useSkill": "punch",
        "effect": { "拳力": 2, "海灵": 5, "feud": "钓钩被你打成了直的" }, "result": "你一拳把钩子打成了直的。船上那人收上线，看了很久。" },
      { "text": "认得这股味", "require": "legacy:thorny_tail>=2", "effect": { "灵性": 2, "海灵": 4 },
        "result": "前世你闻着葱姜味上了桌。这一世这股味一飘过来，你掉头就游。" }
    ]
  },
  {
    "id": "m_u3_hull", "dir": "up", "layers": ["U3"], "weight": 10,
    "text": "船底的藤壶挤成一片，嘴一张一合地议论：这船今晚往北，网是新换的。",
    "choices": [
      { "text": "听它们说完", "effect": { "灵性": 2 }, "result": "船长怕老婆，网眼是十字的，夜里两点收网。你全记下了。" },
      { "text": "敲几个下来", "chance": 0.6, "chanceAttr": "拳力", "chanceStep": 0.08,
        "effect": { "拳力": 2, "体力": 1 }, "result": "你敲下几个吃了。剩下的全闭上嘴，再不说话。",
        "fail": { "effect": { "体力": -1 }, "result": "藤壶长得比水泥还牢。你敲了半天，只敲下一身灰。" } },
      { "text": "打听是哪张网", "require": "legacy:net_sense>=1", "effect": { "灵性": 2, "游速": 2 },
        "result": "前世你没看清那张网。这一世你问清了网眼，提前绕了过去。" }
    ]
  },

  {
    "id": "m_u4_rainbow", "dir": "up", "layers": ["U4"], "stage": [1, 99], "weight": 10,
    "text": "浪尖上挂着一道彩虹。别人看见七种颜色，你看见了十二种，还有四种在晃。",
    "choices": [
      { "text": "盯着数", "effect": { "灵性": 3, "体力": -1 }, "result": "你数到第十六种，浪就落下去了。剩下那种，下回再看。" },
      { "text": "趁浪吸海灵", "chance": 0.6, "chanceAttr": "游速", "chanceStep": 0.06,
        "effect": { "海灵": 6 }, "result": "你骑着浪头吸了个饱。落回水里时，壳都是暖的。",
        "fail": { "effect": { "体力": -2 }, "result": "浪落得太快，你被拍进水里，晕了半天。" } },
      { "text": "冲进去打一拳", "absurd": true, "chance": 0.2, "chanceAttr": "灵性", "chanceStep": 0.02,
        "effect": { "灵性": 3, "海灵": 15 }, "result": "你一拳打进彩虹里。钳子染了一季的光，夜里都发亮。",
        "fail": { "effect": { "体力": -2 }, "result": "你从彩虹这头冲到那头，什么都没打着，摔回了海里。" } },
      { "text": "钳上雷纹发亮", "require": "legacy:thunder_mark>=1", "effect": { "灵性": 2, "海灵": 8 },
        "result": "前世雷劈过你。这一世雷纹碰上彩虹，钳子嗡地亮了一下。" }
    ]
  },
  {
    "id": "m_u4_surfer", "dir": "up", "layers": ["U4"], "stage": [1, 99], "weight": 10,
    "text": "一个踩板子的人从浪上滑下来，板子擦着你的眼柄过去，他还回头比了个手势。",
    "choices": [
      { "text": "沉下去躲", "effect": { "游速": 1, "体力": 1 }, "result": "你沉下去等他滑远。人在浪上玩的东西，你看不懂。" },
      { "text": "追上去打板子", "chance": 0.45, "chanceAttr": "游速", "chanceStep": 0.05,
        "effect": { "拳力": 2, "海灵": 6, "feud": "冲浪板被你打出个坑" }, "result": "你一拳打在板底。他晃了两晃栽进浪里，爬上来就摸板上的坑。",
        "fail": { "effect": { "体力": -2 }, "result": "他滑得太快，你追了半个浪，累得直吐泡泡。" } },
      { "text": "扒上板子", "absurd": true, "chance": 0.15, "chanceAttr": "游速", "chanceStep": 0.02,
        "effect": { "游速": 3, "海灵": 12 }, "result": "你扒在板底跟着冲完了整个浪。他上岸都不知道带了乘客。",
        "fail": { "effect": { "death": "wave" }, "result": "板子一翻，你和他一起飞向礁石。他戴了护具。" } }
    ]
  },

  {
    "id": "m_d1_snail", "dir": "down", "layers": ["D1"], "weight": 12,
    "text": "一只玉螺在沙里钻来钻去，留下一串洞。它说：这片沙，挖洞我第一。",
    "choices": [
      { "text": "跟它比", "chance": 0.55, "chanceAttr": "打洞", "chanceStep": 0.08,
        "effect": { "打洞": 2, "海灵": 3, "follow": { "id": "m_c_snail", "delay": 2 } }, "result": "你挖了个 U 形洞，还带拐角。玉螺看了看，说下回再比。",
        "fail": { "effect": { "打洞": 1, "体力": -1, "follow": { "id": "m_c_snail", "delay": 2 } }, "result": "它一季钻了九个洞，你钻了三个。它很得意。" } },
      { "text": "随它去", "effect": { "体力": 1 }, "result": "你缩回洞里睡觉。第一让给它，你还要睡。" },
      { "text": "挖三下歇一下", "require": "legacy:endurance>=1", "effect": { "打洞": 2, "体力": 1 },
        "result": "前世你挖到最后一口气。这一世你挖三下歇一下，挖得比它深。" }
    ]
  },
  {
    "id": "m_c_snail", "dir": "down", "layers": ["D1", "D2"], "chainOnly": true,
    "teaser": "玉螺说要再比一次",
    "text": "玉螺又来了，身后跟着一串小玉螺看热闹。它说：这回比谁挖得深。",
    "choices": [
      { "text": "认真比", "chance": 0.5, "chanceAttr": "打洞", "chanceStep": 0.08,
        "effect": { "打洞": 3, "海灵": 5, "feud": "玉螺当众认输了" }, "result": "你一口气挖穿了沙层。玉螺看着洞底，带着小玉螺们走了。",
        "easy": "你挖到一半回头看，玉螺还在找下嘴的地方。",
        "fail": { "effect": { "打洞": 1, "体力": -1 }, "result": "你挖到了石头。玉螺笑得壳都在抖。" } },
      { "text": "教小玉螺挖", "effect": { "灵性": 2, "打洞": 1 }, "result": "你教小玉螺挖 U 形洞。玉螺在旁边看着，偷偷也学了。" },
      { "text": "直接一拳", "absurd": true, "chance": 0.25, "chanceAttr": "拳力", "chanceStep": 0.03,
        "effect": { "拳力": 2, "海灵": 6 }, "result": "你一拳把它的壳打翻了。它在沙上转了三圈，说算你第一。",
        "fail": { "effect": { "体力": -1 }, "result": "它缩进壳里。你打了一季，它在里面睡了一季。" } }
    ]
  },
  {
    "id": "m_d1_starfish", "dir": "down", "layers": ["D1"], "weight": 10,
    "text": "一只海星趴在你洞口睡觉，五个角摊得平平的，把门堵死了。",
    "choices": [
      { "text": "走后门", "effect": { "游速": 1, "体力": -1 }, "result": "你从 U 形洞另一头钻出去。回来时它翻了个身，还在。" },
      { "text": "把它掀过来", "chance": 0.6, "chanceAttr": "拳力", "chanceStep": 0.08,
        "effect": { "拳力": 1, "体力": 2 }, "result": "你一拳把它掀了个面。它慢慢翻回来，慢慢爬走了。",
        "fail": { "effect": { "体力": -1 }, "result": "它吸得太牢。你推了一季，它睡了一季。" } },
      { "text": "跟它挤着睡", "absurd": true, "chance": 0.3, "chanceAttr": "灵性", "chanceStep": 0.02,
        "effect": { "体力": 3, "灵性": 2 }, "result": "你钻到它底下睡了。它挡光，挡浪，还挡海鸥。好邻居。",
        "fail": { "effect": { "体力": -1 }, "result": "它半夜翻身，压了你一整宿。" } }
    ]
  },
  {
    "id": "m_d1_tidal_salt", "dir": "down", "layers": ["D1"], "maps": ["tidal"], "weight": 12,
    "text": "洞口突然落下一把白东西，咸得呛人。隔壁的蛏子受不了，嗖地蹿了出去。",
    "choices": [
      { "text": "憋住别动", "chance": 0.6, "chanceAttr": "打洞", "chanceStep": 0.08,
        "effect": { "打洞": 1, "灵性": 2 }, "result": "你缩在洞底一动不动。外头的人等了半天，骂一句走了。",
        "fail": { "effect": { "death": "net" }, "result": "憋到一半，你的脑袋自己探了出去。外头是一只桶。" } },
      { "text": "从后门溜", "effect": { "游速": 1, "体力": -1 }, "result": "你从后门钻出去。回头一看，蛏子已经进桶了。" },
      { "text": "把盐水喷回去", "absurd": true, "chance": 0.2, "chanceAttr": "拳力", "chanceStep": 0.02,
        "effect": { "拳力": 2, "海灵": 8, "feud": "撒盐的人被喷了一脸" }, "result": "你一拳把盐水打出洞口，喷了那人一脸。他揉着眼说这洞有鬼。",
        "fail": { "effect": { "体力": -2 }, "result": "你一拳打下去，盐撒得更匀了。" } },
      { "text": "身上那层水", "require": "legacy:moist>=1", "effect": { "打洞": 1, "体力": 1 },
        "result": "前世你干在了泥上。这一世你身上那层水，把盐全冲淡了。" }
    ]
  },

  {
    "id": "m_d2_echo", "dir": "down", "layers": ["D2"], "weight": 12,
    "text": "缝的最里头有东西在敲石头：咚，咚咚。跟你刚才敲的拍子一模一样。",
    "choices": [
      { "text": "敲回去", "effect": { "灵性": 2, "follow": { "id": "m_c_old_shrimp", "delay": 2 } },
        "result": "你敲了三下，那边也敲了三下。停了一会儿，又多敲了一下。" },
      { "text": "堵上缝", "effect": { "打洞": 2, "体力": 1 }, "result": "你用碎石把缝堵死了。睡得很香，就是总梦见有人敲门。" },
      { "text": "认得这敲法", "require": "legacy:old_shrimp>=1", "effect": { "灵性": 3, "海灵": 5, "follow": { "id": "m_c_old_shrimp", "delay": 2 } },
        "result": "前世你老在一条缝里，也这么敲过。这一世你听出来了：那边是只老虾。" }
    ]
  },
  {
    "id": "m_c_old_shrimp", "dir": "down", "layers": ["D2", "D3"], "chainOnly": true,
    "teaser": "缝底有只老虾在敲墙",
    "text": "缝底趴着一只老皮皮虾，壳褪成了灰白，眼睛不太亮了。它说：好久没人回话了。",
    "choices": [
      { "text": "陪它聊一季", "effect": { "灵性": 3, "体力": 1 }, "result": "它讲了一季这片海的事。哪儿有吃的，哪片水别去，你全记下了。" },
      { "text": "跟它学拳", "chance": 0.6, "chanceAttr": "拳力", "chanceStep": 0.06,
