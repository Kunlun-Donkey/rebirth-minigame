        "fail": { "effect": { "follow": "f_hen_revenge", "体力": -1 }, "result": "它啄了你的鼻子。你哼唧着跑回了柴堆。" } },
      { "text": "绕着走", "effect": { "脚力": 1 }, "result": "你绕了好大一圈。腿倒是练出来了。" }
    ]
  },
  {
    "id": "s0_down_xiaocui", "dir": "down", "stage": [0, 0], "weight": 25, "once": true,
    "text": "一个扎羊角辫的小姑娘蹲下来看你。她说：你就叫小黄吧。",
    "choices": [
      { "text": "摇尾巴", "effect": { "忠义": 2, "flag": "xiaocui" }, "result": "她笑了。她说她叫小翠。" },
      { "text": "舔她的手", "effect": { "忠义": 1, "体力": 2, "flag": "xiaocui" }, "result": "她把半个窝头塞进了你嘴里。她说她叫小翠。" }
    ]
  },
  {
    "id": "s0_down_bone", "dir": "down", "stage": [0, 0], "weight": 12,
    "text": "柴堆底下的土是松的，有一股骨头的味道。",
