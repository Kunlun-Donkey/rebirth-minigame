[
  {
    "id": "s0_up_smell", "dir": "up", "stage": [0, 0], "weight": 20,
    "text": "柴堆外头飘来一股香味，是从山那边来的。你的鼻子比眼睛先醒了。",
    "choices": [
      { "text": "爬出去闻闻", "effect": { "脚力": 1, "体力": -1 }, "result": "你摔了三个跟头，爬到了柴堆外面。山，好大。" },
      { "text": "缩回窝里", "effect": { "体力": 1 }, "result": "窝里暖和。香味明天还会有的。" }
    ]
  },
  {
    "id": "s0_up_hen", "dir": "up", "stage": [0, 0], "weight": 12,
    "text": "一只老母鸡挡在路上，咯咯叫着要啄你。它比你大两圈。",
    "choices": [
      { "text": "冲上去", "chance": 0.5, "chanceAttr": "牙口", "chanceStep": 0.1,
