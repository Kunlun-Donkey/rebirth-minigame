          "fail": { "effect": { "精力": -3 }, "result": "【叮！】宿主违约。系统强制你关机三天。" } },
        { "text": "带系统去体检", "absurd": true, "chance": 0.25, "chanceAttr": "心态", "chanceStep": 0.04,
          "effect": { "精力上限": 2, "state": "tasked" }, "result": "医生看完报告：你这身体比我还好。【叮！】那是。",
          "fail": { "effect": { "心态": -1 }, "result": "医生问你脑子里的声音响了多久。你说没有，没有。" } }
      ]
    },
    {
      "id": "antijuan_bind", "careers": ["office"], "dir": "up", "layers": ["U1", "U2"], "once": true, "weight": 20, "stage": [1, 99],
      "require": "!system:any & (line:wang_juanjuan.rival | 精力<=2)",
      "text": "隔壁工位凌晨三点还在回邮件。你卷不动了，趴在桌上。【叮！】反卷系统：别人卷，你涨修为。",
      "choices": [
        { "text": "绑定", "effect": { "bind": "sys_antijuan", "state": "bound", "follow": "antijuan_task" },
