          "effect": { "身价": 30, "能力": 2 }, "result": "【叮！】满级。系统放了一段烟花，附赠一句：宿主英明。",
          "fail": { "effect": { "death": "overload" }, "result": "【叮！】升级包过大，宿主内存不足。宿主……宿主——" } }
      ]
    },
    {
      "id": "confiscate", "dir": "any", "once": true, "weight": 10, "stage": [2, 99],
      "require": "system:any & (line:system.bound | line:system.tasked)",
      "text": "天道敲了敲你的脑门：外挂，交出来。系统在你脑子里缩成一团，一声不吭。",
