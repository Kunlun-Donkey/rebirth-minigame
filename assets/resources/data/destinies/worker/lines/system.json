          "effect": { "身价": 20, "能力": 2, "state": "tasked" }, "result": "卷王一晚上做完了一周的任务。修为全算你的。",
          "fail": { "effect": { "unbind": true, "心态": -1 }, "result": "【叮！】检测到卷王更适合当宿主。系统连夜跳槽了。" } }
      ]
