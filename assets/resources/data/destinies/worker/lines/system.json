{
  "id": "system",
  "name": "系统",
  "summary": "七个系统排着队找上门。绑不绑、做不做任务、最后谁给谁打工——这一世，你说了算。",
  "states": {
    "bound": "绑定了系统",
    "tasked": "完成了系统任务",
    "owned": "系统认主",
    "deleted": "删除了系统"
  },
  "events": [
    {
      "id": "signin_bind", "careers": ["office"], "dir": "up", "layers": ["U1"], "once": true, "weight": 8, "require": "!system:any & season<=3",
      "text": "入职第一天，你刚坐到工位上，脑子里响了一声：【叮！】检测到宿主落座，签到系统绑定中……",
      "choices": [
        { "text": "绑定", "effect": { "bind": "sys_signin", "state": "bound", "follow": { "id": "signin_task", "delay": 2 } },
          "result": "【叮！】绑定成功。今日签到奖励：身价+1。你觉得这系统很懂你。" },
        { "text": "不用了，谢谢", "effect": { "心态": 1 }, "result": "天道：难得有个不要外挂的。系统叹了口气，去找隔壁工位了。" },
        { "text": "前世卸过系统", "require": "ever:system.deleted", "effect": { "心态": 2, "能力": 1 },
          "result": "前世你亲手删过系统。这一世你只说：不必了。【叮！】……好的。" },
        { "text": "能补签前世十年吗", "absurd": true, "chance": 0.2, "chanceAttr": "脸皮", "chanceStep": 0.03,
          "effect": { "bind": "sys_signin", "state": "bound", "身价": 6, "follow": { "id": "signin_task", "delay": 2 } },
          "result": "【叮！】……系统查了你前世的考勤，沉默了。批了，身价+6。",
          "fail": { "effect": { "心态": -1 }, "result": "【叮！】检测到宿主贪心。系统转身绑定了隔壁的王卷卷。" } }
      ]
    },
    {
      "id": "signin_task", "dir": "up", "weight": 12, "teaser": "【叮！】连续签到任务已发布", "require": "system:sys_signin",
      "text": "【叮！】新任务：连续签到三十天，奖励神秘大礼包。断签一天，清零。今天周六，外面下着暴雨。",
      "choices": [
        { "text": "冒雨去公司签到", "effect": { "精力": -1, "身价": 8, "item": "coffee", "state": "tasked" },
          "result": "你浑身湿透坐到工位。【叮！】大礼包到账：一杯冰美式。" },
        { "text": "在家签行不行", "chance": 0.4, "chanceAttr": "脸皮", "chanceStep": 0.06,
          "effect": { "身价": 5, "state": "tasked" }, "result": "【叮！】……检测到宿主坐在椅子上。勉强算你过。",
          "easy": "你把家里的椅子拍照发给系统。【叮！】……行，你赢了。",
          "fail": { "effect": { "心态": -2 }, "result": "【叮！】宿主断签。累计天数清零。系统很失望。" } },
        { "text": "跟系统吵补签卡", "absurd": true, "chance": 0.15, "chanceAttr": "脸皮", "chanceStep": 0.03,
          "effect": { "身价": 15, "能力": 1, "state": "tasked" }, "result": "你和系统吵了半小时。它说你比上一个宿主难缠，给你补了。",
          "fail": { "effect": { "心态": -1 }, "result": "【叮！】补签卡售价：身价 30。你默默关掉了提示。" } }
      ]
    },
    {
      "id": "shenhao_bind", "dir": "any", "once": true, "weight": 20, "stage": [1, 99], "require": "!system:any & 身价<=15 & season>=3",
      "text": "交完房租，余额 0.37 元。【叮！】检测到宿主穷得很纯粹，神豪系统请求绑定。",
      "choices": [
        { "text": "绑定", "effect": { "bind": "sys_shenhao", "state": "bound", "身价": 3, "follow": "shenhao_task" },
          "result": "【叮！】绑定成功，新手礼包到账。你盯着余额，数了三遍零。" },
        { "text": "不要，吃泡面", "effect": { "心态": 1, "脸皮": 1 }, "result": "天道：难得有个不要外挂的。你吃了一包泡面，睡得很香。" },
        { "text": "前世背过一身债", "require": "legacy:bookkeeping>=1", "effect": { "身价": 6, "能力": 1 },
          "result": "前世你背过一身债。这一世 0.37 元也做成表格，一分没乱花。" },
        { "text": "能先预支吗", "absurd": true, "chance": 0.2, "chanceAttr": "脸皮", "chanceStep": 0.03,
          "effect": { "bind": "sys_shenhao", "state": "bound", "身价": 10, "follow": "shenhao_task" },
          "result": "【叮！】本系统第一次被宿主借钱。……批了。",
          "fail": { "effect": { "心态": -1 }, "result": "【叮！】宿主信用分过低。系统转身绑定了你的房东。" } }
      ]
    },
    {
      "id": "shenhao_task", "dir": "any", "weight": 12, "teaser": "【叮！】花钱任务已发布", "require": "system:sys_shenhao",
      "text": "【叮！】任务：一天内花光十万，只能花在自己身上。完成奖励一百万。失败，全部没收。",
      "choices": [
        { "text": "体检加保温杯", "effect": { "精力上限": 1, "精力": 2, "身价": 12, "state": "tasked" },
          "result": "全套体检、健身卡、二十个保温杯。【叮！】……行吧，算你的。" },
        { "text": "给爸妈买房", "chance": 0.35, "chanceAttr": "心态", "chanceStep": 0.05,
          "effect": { "身价": 20, "人脉": 2, "state": "tasked" }, "result": "【叮！】爸妈也算宿主的一部分……这个漏洞，系统认了。",
          "fail": { "effect": { "身价": -5, "心态": 1 }, "result": "【叮！】花在别人身上，任务失败。爸妈很高兴，系统不高兴。" } },
        { "text": "买下老周的公司", "absurd": true, "chance": 0.2, "chanceAttr": "脸皮", "chanceStep": 0.03,
          "effect": { "身价": 25, "state": "tasked", "feud": "十万买下了老周的公司" },
          "result": "老周的公司估值九万八。你还找回了两千。",
          "fail": { "effect": { "心态": -2 }, "result": "老周说：十万？连我的饼都买不起。" } }
      ]
    },
    {
      "id": "slack_bind", "careers": ["office"], "dir": "down", "layers": ["D1"], "once": true, "weight": 7, "require": "!system:any & season>=3",
      "text": "你第三次在茶水间被老板撞见。他刚要开口，你脑子里响了：【叮！】摸鱼天赋检测满分。",
      "choices": [
        { "text": "绑定", "effect": { "bind": "sys_slack", "state": "bound", "follow": "slack_task" },
          "result": "【叮！】绑定成功。老板话说到一半，忘了自己要说什么。" },
        { "text": "拒绝，回工位", "effect": { "能力": 1, "心态": 1 }, "result": "天道：难得有个不要外挂的。老板看你回了工位，满意地走了。" },
        { "text": "绑定算工时吗", "absurd": true, "chance": 0.25, "chanceAttr": "脸皮", "chanceStep": 0.04,
          "effect": { "bind": "sys_slack", "state": "bound", "精力": 2, "follow": "slack_task" },
          "result": "【叮！】本系统认可宿主的摸鱼觉悟。绑定期间，带薪。",
          "fail": { "effect": { "心态": -1 }, "result": "你和系统讨价还价的时候，老板一直站在旁边。" } }
      ]
    },
    {
      "id": "slack_task", "dir": "down", "weight": 12, "teaser": "【叮！】摸鱼任务已发布", "require": "system:sys_slack",
      "text": "【叮！】任务：今天摸鱼满八小时，不得被发现。检测到宿主在工作，扣十分。",
      "choices": [
        { "text": "带薪如厕八小时", "chance": 0.5, "chanceAttr": "脸皮", "chanceStep": 0.06,
          "effect": { "精力": 3, "心态": 1, "state": "tasked" }, "result": "你在隔间刷完了一整部剧。【叮！】任务完成。奖励：明天继续。",
          "fail": { "effect": { "心态": -1 }, "result": "你蹲到第三小时，老板敲门：用完了吗？" } },
        { "text": "抱电脑假装开会", "effect": { "精力": 1, "身价": 3, "state": "tasked" },
          "result": "你在会议室坐了一天。没人敢问你在开什么会。" },
        { "text": "认真干活", "effect": { "能力": 2, "精力": -1 }, "result": "【叮！】警告：宿主在工作。你升职了，系统很难过。" },
        { "text": "前世累进过医院", "require": "legacy:wellness>=1", "effect": { "精力上限": 1, "心态": 1, "state": "tasked" },
          "result": "前世你累进了医院。这一世你摸鱼摸得心安理得，系统都夸你。" }
      ]
    },
    {
      "id": "eye_bind", "careers": ["office"], "dir": "up", "layers": ["U2"], "once": true, "weight": 18, "stage": [1, 99], "require": "!system:any",
      "text": "你熬了三个通宵的方案，组长在会上念成了他的。散会时，眼前跳出一行字：【叮！】天眼系统，看清谁在坑你。",
      "choices": [
        { "text": "绑定", "effect": { "bind": "sys_eye", "state": "bound", "follow": "eye_task" },
          "result": "【叮！】绑定成功。你再看组长，他头顶飘着两个字：心虚。" },
        { "text": "不用，我有记录", "effect": { "心态": 1, "能力": 1, "feud": "组长抢功被记录拆穿" },
          "result": "天道：难得有个不要外挂的。你把修改记录发到了群里。" },
        { "text": "前世背过锅", "require": "legacy:paper_trail>=1", "effect": { "能力": 2, "身价": 6, "feud": "组长抢的功原样退回" },
          "result": "前世你背过锅。这一世每一版都抄送了全组。组长念到一半，自己停了。" },
        { "text": "能看彩票号吗", "absurd": true, "chance": 0.15, "chanceAttr": "脸皮", "chanceStep": 0.03,
          "effect": { "bind": "sys_eye", "state": "bound", "身价": 8, "follow": "eye_task" },
          "result": "【叮！】只能看昨天的。可昨天的事，已经够你用了。",
          "fail": { "effect": { "心态": -1 }, "result": "【叮！】彩票功能需开通会员。你没开，系统也走了。" } }
      ]
    },
    {
      "id": "eye_task", "dir": "up", "weight": 12, "teaser": "【叮！】天眼看见了一个坑", "require": "system:sys_eye",
      "text": "【叮！】天眼任务：揭穿一次谎言。前方：老板正在画饼，饼里有坑，坑里有你。",
      "choices": [
        { "text": "当场指出坑", "chance": 0.45, "chanceAttr": "能力", "chanceStep": 0.05,
          "effect": { "身价": 10, "能力": 1, "state": "tasked" }, "result": "你指出合同第三页的坑。老板愣住，改了条款。【叮！】任务完成。",
          "easy": "你还没开口，老板先把第三页撕了。【叮！】任务完成。",
          "fail": { "effect": { "心态": -2 }, "result": "你说得对，但没证据。老板记住你了。" } },
        { "text": "悄悄绕开", "effect": { "心态": 1, "state": "tasked" }, "result": "你换了个项目组。三个月后那个项目黄了。【叮！】勉强算完成。" },
        { "text": "前世吃了十年饼", "require": "legacy:pie_sense>=1", "effect": { "身价": 12, "心态": 1, "state": "tasked" },
          "result": "前世你吃了十年饼。这一世天眼还没报完，你已经报出了饼的尺寸。" },
        { "text": "偷看老板工资条", "absurd": true, "chance": 0.2, "chanceAttr": "脸皮", "chanceStep": 0.03,
          "effect": { "身价": 15, "state": "tasked" }, "result": "你看到了老板的工资条。他看到了你的眼神，给你涨了薪。",
          "fail": { "effect": { "unbind": true, "心态": -2 }, "result": "【叮！】越权查看。天道：外挂，没收。" } }
      ]
    },
    {
      "id": "undying_bind", "dir": "any", "once": true, "weight": 24, "stage": [1, 99], "require": "!system:any & 精力<=2",
      "text": "连轴转第三周，你眼前一黑，扶住了桌子。【叮！】检测到宿主血条见底，不死系统紧急上线。",
      "choices": [
        { "text": "绑定", "effect": { "bind": "sys_undying", "state": "bound", "精力": 2, "follow": "undying_task" },
          "result": "【叮！】绑定成功。你直起了腰。本系统不接受退货。" },
        { "text": "请假回家睡觉", "effect": { "精力": 3, "心态": 1 }, "result": "天道：难得有个不要外挂的。你睡了两天，醒来天是蓝的。" },
        { "text": "前世累垮过", "require": "legacy:wellness>=1", "effect": { "精力": 4, "精力上限": 1 },
