          "effect": { "bind": "sys_antijuan", "state": "bound", "身价": 12, "follow": "antijuan_task" },
          "result": "你给隔壁点了份夜宵。他吃饱了接着卷，你的修为蹭蹭涨。",
          "fail": { "effect": { "心态": -2 }, "result": "【叮！】检测到宿主教唆内卷。系统拒绝了你。" } }
      ]
    },
    {
      "id": "antijuan_task", "dir": "up", "weight": 12, "teaser": "【叮！】反卷任务已发布", "require": "system:sys_antijuan",
      "text": "【叮！】任务：本周全组准点下班。检测到隔壁工位已经订好了通宵的咖啡。",
      "choices": [
        { "text": "六点拉闸", "chance": 0.4, "chanceAttr": "脸皮", "chanceStep": 0.05,
