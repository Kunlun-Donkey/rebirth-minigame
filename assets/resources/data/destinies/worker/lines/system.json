        { "text": "能顺便不加班吗", "absurd": true, "chance": 0.2, "chanceAttr": "心态", "chanceStep": 0.03,
          "effect": { "bind": "sys_undying", "state": "bound", "精力": 4, "心态": 1, "follow": "undying_task" },
          "result": "【叮！】不加班超纲了。系统给你批了三天假，当没听见。",
          "fail": { "effect": { "精力": 1 }, "result": "【叮！】超出服务范围。系统挂了，你还扶着桌子。" } }
      ]
    },
    {
      "id": "undying_task", "dir": "any", "weight": 12, "teaser": "【叮！】不死任务已发布", "require": "system:sys_undying",
      "text": "【叮！】任务：本季每天睡满八小时。宿主不死，是本系统的 KPI。",
      "choices": [
        { "text": "照做，早睡", "effect": { "精力": 3, "心态": 1, "state": "tasked" },
