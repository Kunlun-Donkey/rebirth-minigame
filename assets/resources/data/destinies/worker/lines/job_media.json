      "choices": [
        {
          "text": "道歉，退钱",
          "effect": {
            "心态": 1,
            "身价": -8,
            "人脉": 1
          },
          "result": "你一个个退了钱。有人说：至少他认了。"
        },
        {
          "text": "硬刚",
          "chance": 0.15,
          "chanceAttr": "脸皮",
          "chanceStep": 0.02,
          "effect": {
            "脸皮": 3,
            "身价": 5
