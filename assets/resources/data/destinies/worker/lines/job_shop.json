{
  "id": "job_shop",
  "name": "开小店",
  "summary": "一间十几平的铺子，一块自己写的招牌。开成一条街、守成百年老店，或者每天四点关门，陪一只橘猫晒太阳。",
  "careers": [
    "shop"
  ],
  "states": {
    "regulars": "有了一群回头客",
    "branch": "开了分店",
    "cat": "店里来了一只橘猫",
    "old_shop": "决定守着这间老店",
    "rent": "和房东较上了劲"
  },
  "events": [
    {
      "id": "opening",
      "dir": "up",
      "layers": [
        "U1"
      ],
      "weight": 14,
      "text": "开业第一周，每天进店的人不到十个。对面新开了一家连锁便利店，门口排着长队。",
      "choices": [
        {
          "text": "记住每个客人",
          "effect": {
            "state": "regulars",
            "人脉": 2,
            "心态": 1
          },
          "result": "第二次来的客人，你都叫得出名字。他们第三次来，带了朋友。"
        },
        {
          "text": "搞开业促销",
          "chance": 0.5,
          "chanceAttr": "脸皮",
          "chanceStep": 0.05,
          "effect": {
            "身价": 6,
            "人脉": 1
          },
          "result": "满五十送一把伞。那天下午下了场雨，你的伞全送完了。",
          "fail": {
            "effect": {
              "身价": -4
            },
            "result": "你印了一千张传单。来的人，都是来领鸡蛋的。"
          }
        },
        {
          "text": "前世开过店",
          "require": "pastcareer:shop",
          "effect": {
            "身价": 8,
            "能力": 1,
            "state": "regulars"
          },
          "result": "前世你的店关在第三年。这一世，你知道那三年里每一步该怎么走。"
        }
      ]
    },
    {
      "id": "regular",
      "dir": "up",
      "layers": [
        "U1",
        "U2"
      ],
      "weight": 12,
      "text": "隔壁的王老师每天七点来买一瓶牛奶。今天他没来。第二天也没来。",
      "choices": [
        {
          "text": "上门看看",
          "effect": {
            "人脉": 2,
            "心态": 2,
            "state": "regulars"
          },
          "result": "王老师摔了一跤，躺在床上起不来。你叫了救护车，在医院陪到半夜。"
        },
        {
          "text": "给他留着",
          "effect": {
            "心态": 1
          },
          "result": "你每天在冰柜里给他留一瓶。第七天，他拄着拐杖来了。"
        }
      ]
    },
    {
      "id": "rent",
      "dir": "up",
      "layers": [
        "U1",
        "U2"
      ],
      "weight": 12,
      "stage": [
        1,
        99
      ],
      "text": "房东来了：明年房租涨三成。你算了一晚上，涨完以后，你一个月白干。",
      "choices": [
        {
          "text": "跟房东谈",
          "chance": 0.45,
          "chanceAttr": "人脉",
          "chanceStep": 0.05,
          "effect": {
            "身价": 4,
            "人脉": 1
          },
          "result": "你说你在这儿开了三年，街坊都认。房东想了想，只涨了一成。",
          "fail": {
            "effect": {
              "state": "rent",
              "心态": -2,
              "身价": -6
            },
            "result": "房东说：不租有的是人租。你签了字，手有点抖。"
          }
        },
        {
          "text": "搬到巷子里",
          "effect": {
            "身价": -3,
            "能力": 1,
            "心态": 1
          },
          "result": "新铺子在巷子深处，房租一半。老客人们跟着找了过来。"
        },
        {
          "text": "撑不下去了",
          "effect": {
            "death": "shop_closed"
          },
          "result": "你把招牌摘下来，夹在胳膊底下，走了。"
        },
        {
          "text": "回头客联名",
          "require": "line:job_shop.regulars & 人脉>=6",
          "effect": {
            "人脉": 2,
            "身价": 6,
            "feud": "房东收到了一百个签名"
          },
          "result": "一百个街坊联名写了封信。房东看完，房租没涨。"
        }
      ]
    },
    {
      "id": "branch",
      "dir": "up",
      "layers": [
        "U2"
      ],
      "weight": 14,
      "text": "隔壁街有间铺子要转让，位置比你现在的还好。银行说，可以贷款。",
      "choices": [
        {
          "text": "开分店",
          "chance": 0.5,
          "chanceAttr": "能力",
          "chanceStep": 0.05,
          "effect": {
            "state": "branch",
            "身价": 10,
            "能力": 1
          },
          "result": "第二家店开张了。你站在两家店中间的路口，左看看，右看看。",
          "fail": {
            "effect": {
              "身价": -8,
              "心态": -2
            },
            "result": "两家店抢的是同一拨客人。你每天来回跑，两边都没顾上。"
          }
        },
        {
          "text": "守好一家",
          "effect": {
            "心态": 2,
            "身价": 3
          },
          "result": "你把钱花在了换货架和装空调上。客人说：你家店，越来越舒服了。"
        }
      ]
    },
    {
      "id": "chain",
      "dir": "up",
      "layers": [
        "U3"
      ],
      "weight": 14,
      "text": "你的店开到了第十家。连锁超市的人来了：开个价，我们全收了。",
      "choices": [
        {
          "text": "不卖",
          "effect": {
            "人脉": 2,
            "能力": 2
          },
          "result": "你说：我的店，每家都有人记得王老师要几点买牛奶。"
        },
        {
          "text": "卖一半",
          "effect": {
            "身价": 25
          },
          "result": "你卖掉了五家。剩下五家，招牌还是你写的那几个字。"
        },
        {
          "text": "反过来收购他们",
          "absurd": true,
          "chance": 0.15,
          "chanceAttr": "能力",
          "chanceStep": 0.02,
          "effect": {
            "身价": 40,
            "feud": "连锁超市被小店收购了"
          },
          "result": "你查了他们的账，一塌糊涂。三个月后，你把他们收了。",
          "fail": {
            "effect": {
              "心态": -1
            },
            "result": "那人笑了：小老板，口气不小。"
          }
        }
      ]
    },
    {
      "id": "street",
      "dir": "up",
      "layers": [
        "U3",
        "U4"
      ],
      "once": true,
      "weight": 14,
      "stage": [
        3,
        99
      ],
      "text": "整条老街要改造，开发商想全拆了建商场。街坊们都看向了你：你那么多店，你说句话。",
      "choices": [
        {
          "text": "盘下整条街",
          "require": "stage>=4 & 人脉>=12 & line:job_shop.branch",
          "effect": {
            "ending": "shop_street"
          },
          "result": "你和开发商谈了三个月。老街没拆，招牌一块一块重新亮了起来。"
        },
        {
          "text": "带街坊去听证",
          "effect": {
            "人脉": 3,
            "心态": 1
          },
          "result": "老街保住了一半。王老师拄着拐杖，在听证会上讲了二十分钟。"
        },
        {
          "text": "拿补偿走人",
          "effect": {
            "身价": 30,
            "心态": -2
          },
          "result": "补偿款很多。你再路过那里时，只剩一个商场。"
        },
        {
          "text": "找当年涨租的房东",
          "require": "line:job_shop.rent",
          "effect": {
            "身价": 10,
            "人脉": 2,
            "feud": "房东把铺子卖给了你"
          },
          "result": "老房东要移民了。他说：这间铺子，卖给你，我放心。"
        }
      ]
    },
    {
      "id": "kitchen",
      "dir": "down",
      "layers": [
        "D1"
      ],
      "weight": 12,
      "text": "打烊后，你在后厨给自己煮了一碗面。案板上，还剩半根葱和一个鸡蛋。",
      "choices": [
        {
          "text": "加个蛋",
          "effect": {
            "精力": 2,
            "心态": 1
          },
          "result": "你吃完面，把碗洗了，坐着发了会儿呆。今天也挺好。"
        },
        {
          "text": "把账算了",
          "effect": {
            "能力": 1,
            "身价": 2
          },
          "result": "你发现每周三的生意最差。下周三，你搞了个半价。"
        }
      ]
    },
    {
      "id": "cat",
      "dir": "down",
      "layers": [
        "D1",
        "D2"
      ],
      "once": true,
      "weight": 12,
      "text": "仓库里传来一声猫叫。一只瘦得皮包骨的橘猫，躲在矿泉水箱后面，盯着你。",
      "choices": [
        {
          "text": "给它开个罐头",
          "effect": {
            "state": "cat",
            "心态": 2,
            "follow": {
              "id": "cat_2",
              "delay": 3,
              "ttl": 10
            }
          },
          "result": "它吃完就走了。第二天，它又来了。第三天，它没走。"
        },
        {
          "text": "把它赶出去",
          "effect": {
            "精力": 1
          },
          "result": "它跳出窗户，回头看了你一眼。"
        }
      ]
    },
    {
      "id": "cat_2",
      "dir": "down",
      "teaser": "橘猫在门口晒太阳",
      "require": "line:job_shop.cat",
      "text": "橘猫胖了一圈，每天下午趴在店门口晒太阳。有人专门坐地铁来看它，顺手买瓶水。",
      "choices": [
        {
          "text": "下午四点就关门",
          "require": "stage>=3 & 心态>=18",
          "effect": {
            "ending": "shop_cat"
          },
          "result": "你把营业时间改成了早十到下午四点。剩下的时间，归猫，也归你。"
        },
        {
          "text": "给它拍视频",
          "effect": {
            "人脉": 3,
            "身价": 4
          },
          "result": "它的视频比你的店出名。有人在评论区问：店长是谁？"
        },
        {
          "text": "给它取个名",
          "effect": {
            "心态": 2
          },
          "result": "你叫它「老板」。从此，店里有两个老板。"
        }
      ]
    },
    {
      "id": "shutter",
      "dir": "down",
      "layers": [
        "D3"
      ],
      "weight": 14,
      "stage": [
        2,
        99
      ],
      "text": "打烊后，你把卷帘门拉下一半，坐在门后听街上的动静。对面那家店，换了第三个老板。",
      "choices": [
        {
          "text": "这间店我守到老",
          "effect": {
            "state": "old_shop",
            "心态": 2
          },
          "result": "你给招牌重新描了一遍字。这间店，你不打算换地方了。"
        },
        {
          "text": "去对面看看",
          "effect": {
            "人脉": 1,
            "能力": 1
          },
          "result": "新老板是个年轻人，手忙脚乱。你教了他三招。"
        }
      ]
    },
    {
      "id": "neighbors",
      "dir": "side",
      "layers": [
        "L1"
      ],
      "weight": 12,
      "text": "街坊们在你店门口下象棋，一下就是一下午。你的门口，比店里热闹。",
      "choices": [
        {
          "text": "摆两把椅子",
          "effect": {
            "人脉": 2,
            "心态": 1
          },
          "result": "大爷们下完棋，顺手买包烟、买瓶水。你的生意，多了一成。"
        },
        {
          "text": "跟大爷杀一盘",
          "chance": 0.4,
          "chanceAttr": "能力",
          "chanceStep": 0.05,
          "effect": {
            "人脉": 2,
            "脸皮": 1,
            "feud": "棋王大爷输给了你"
          },
          "result": "你赢了。棋王大爷不服，连着来了一个月。",
          "fail": {
            "effect": {
              "心态": -1
            },
            "result": "你三步就被将死。大爷说：小老板，好好卖货吧。"
          }
        }
      ]
    },
    {
      "id": "flood",
      "dir": "any",
      "once": true,
      "weight": 6,
      "stage": [
        1,
        99
      ],
      "text": "暴雨，街口淹了。几个放学的孩子被困在公交站，水已经没到了膝盖。",
      "choices": [
        {
          "text": "开门让他们进来",
          "effect": {
            "人脉": 3,
            "心态": 2,
            "身价": -2
          },
          "result": "你给孩子们煮了一锅姜汤，挨个给家长打电话。第二天，家长们都来买东西。"
        },
        {
          "text": "货先搬高",
          "effect": {
            "身价": 3
          },
          "result": "货保住了。你从窗户看出去，孩子们被一个外卖小哥接走了。"
        }
      ]
    },
    {
      "id": "sys_bind",
      "dir": "up",
      "layers": [
        "U1",
        "U2"
      ],
      "once": true,
      "weight": 8,
      "require": "!system:any & season>=2",
      "text": "收银台的扫码器突然自己响了：【叮！】检测到宿主有掌柜天赋，掌柜系统绑定中……",
      "choices": [
        {
          "text": "绑定",
          "effect": {
            "bind": "sys_shop",
            "state": "system.bound",
            "follow": {
              "id": "sys_task",
              "delay": 2
            }
          },
          "result": "【叮！】绑定成功。本系统将记住每一位回头客。"
        },
        {
          "text": "扫码器坏了吧",
          "effect": {
            "能力": 1
          },
          "result": "你拍了扫码器两下。它安静了，系统也走了。"
        },
        {
          "text": "要能收冥币的",
          "absurd": true,
          "chance": 0.2,
          "chanceAttr": "脸皮",
          "chanceStep": 0.03,
          "effect": {
            "bind": "sys_shop",
            "state": "system.bound",
            "心态": 2
          },
          "result": "【叮！】……本系统不接阴间业务。但本系统欣赏你的胆子。",
          "fail": {
            "effect": {
              "心态": -1
            },
            "result": "【叮！】检测到宿主不正经。系统溜了。"
          }
        }
      ]
    },
    {
      "id": "sys_task",
      "dir": "any",
      "teaser": "【叮！】掌柜任务已发布",
      "require": "system:sys_shop",
      "text": "【叮！】任务：本月让一百位回头客说出「老板，老样子」。当前进度：3/100。",
      "choices": [
        {
          "text": "认真记每个人",
          "effect": {
            "state": "system.tasked",
            "人脉": 3,
            "身价": 6
          },
          "result": "月底，第一百个人推门进来：老板，老样子。【叮！】任务完成。"
        },
        {
          "text": "雇人来说",
          "absurd": true,
          "chance": 0.2,
          "chanceAttr": "脸皮",
          "chanceStep": 0.03,
          "effect": {
            "state": "system.tasked",
            "身价": 4
          },
          "result": "【叮！】……检测到托。算了，你的托也成了回头客。",
          "fail": {
            "effect": {
              "心态": -2
            },
            "result": "【叮！】检测到作弊，进度清零。托们还管你要了钱。"
          }
        }
      ]
    }
  ]
}
