      99
    ],
    "require": "line:roommate.friend & line:system.bound & system:sys_shenhao",
    "text": "【叮！】检测到宿主的出租屋正在出售。是否执行「神豪任务：买下整栋楼」？室友在旁边，正在算这个月的房租。",
    "choices": [
      {
        "text": "买",
        "require": "身价>=80",
        "effect": {
          "ending": "landlord"
        },
        "result": "【叮！】交易完成。你把室友的房租改成了零。他愣了三秒，抱住了你。"
      },
      {
        "text": "先给他免一年房租",
        "effect": {
          "人脉": 4,
          "心态": 2,
          "身价": 10
        },
        "result": "【叮！】任务部分完成。室友说：你哪来的钱？你说：发了笔小财。"
      },
      {
        "text": "不买",
        "effect": {
          "心态": 1
        },
        "result": "【叮！】宿主拒绝消费，扣十分。你和室友接着算房租。"
      }
    ]
  },
  {
