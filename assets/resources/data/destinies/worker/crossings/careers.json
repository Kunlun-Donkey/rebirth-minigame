[
  {
    "id": "x_rider_jianbing",
    "dir": "any",
    "once": true,
    "weight": 14,
    "require": "line:job_rider.station & line:jianbing.friend",
    "text": "早上六点，煎饼大爷的摊前蹲满了黄马甲。大爷说：你站里的娃，早饭我包了，记你账上。",
    "choices": [
      {
        "text": "给大爷入股",
        "effect": {
          "人脉": 3,
          "心态": 2,
          "feud": "大爷成了骑手站的食堂"
        },
        "result": "你给大爷换了辆新推车。车上贴着：骑手专供，加蛋免费。"
      },
      {
        "text": "我请了",
        "effect": {
          "人脉": 2,
          "身价": -3
        },
        "result": "二十个骑手吃完，冲你喊了一声：站长大气！"
      }
    ]
  },
  {
