[
  {
    "id": "down_fallback", "dir": "down", "weight": 3,
    "text": "你溜出工位，在楼里转了一圈。没人发现你不见了。",
    "choices": [
      { "text": "多转一圈", "effect": { "心态": 1, "精力": 1 }, "result": "你发现这栋楼的楼梯，比工位有意思。" },
      { "text": "回去吧", "effect": { "能力": 1 }, "result": "你回到工位。键盘上落了一层灰，像在等你。" }
    ]
  },
  {
    "id": "d1_gossip", "dir": "down", "layers": ["D1"], "weight": 12,
    "text": "茶水间里两个同事在小声说：听说要裁员了。看见你进来，他们闭了嘴。",
    "choices": [
      { "text": "装没听见，泡咖啡", "effect": { "心态": 1, "精力": 1 }, "result": "你慢慢泡完咖啡。他们等你走了才接着说。" },
      { "text": "凑过去听", "chance": 0.5, "chanceAttr": "人脉", "chanceStep": 0.06,
        "effect": { "人脉": 2, "心态": 1 }, "result": "他们把名单的事全告诉了你。你不在上面。暂时。",
        "fail": { "effect": { "脸皮": 1 }, "result": "他们看了你一眼，开始聊天气。" } },
      { "text": "前世的简历常备", "require": "legacy:resume_ready>=1", "effect": { "人脉": 2, "身价": 4 },
        "result": "前世你就是在这种传言之后被裁的。这一世你回到工位，把简历更新了一版。" }
    ]
  },
  {
    "id": "d1_coffee_machine", "dir": "down", "layers": ["D1"], "weight": 10,
    "text": "咖啡机坏了。全公司的效率下降了一半，大家在茶水间排队等修理工。",
    "choices": [
      { "text": "跟着排队", "effect": { "人脉": 2 }, "result": "排队的时候，你认识了财务、法务和隔壁部门的总监。" },
      { "text": "下楼买", "effect": { "精力": 2, "身价": -1 }, "result": "你提了十杯上来。大家看你的眼神变了。" },
      { "text": "自己修", "absurd": true, "chance": 0.2, "chanceAttr": "能力", "chanceStep": 0.03,
        "effect": { "能力": 2, "人脉": 3 }, "result": "你拍了它一下，它喷出一杯完美的拿铁。从此你是茶水间之神。",
        "fail": { "effect": { "精力": -1 }, "result": "它喷了你一身咖啡渣。" } }
    ]
  },
  {
    "id": "d2_stairwell_call", "dir": "down", "layers": ["D2"], "weight": 12,
    "text": "楼梯间里有人在打电话，声音发抖：妈，我这边挺好的，你别担心。",
    "choices": [
      { "text": "悄悄退出去", "effect": { "心态": 1 }, "result": "你轻轻关上了门。每个人都有一个不能在工位上打的电话。" },
      { "text": "等他打完，递根棒棒糖", "effect": { "人脉": 2, "心态": 1 }, "result": "他接过去，笑了一下：你也来这儿躲啊？" },
      { "text": "给自己老妈也打一个", "effect": { "心态": 2, "精力": 1 }, "result": "老妈问你吃了没。你说吃了。这次是真的吃了。" }
    ]
  },
  {
    "id": "d2_nap", "dir": "down", "layers": ["D2"], "weight": 10,
    "text": "楼梯间顶楼的拐角，有一块没人的台阶，阳光正好照在上面。",
    "choices": [
      { "text": "睡二十分钟", "effect": { "精力": 3 }, "result": "你醒来的时候，阳光挪了一格。你觉得自己又能干十年。" },
      { "text": "带薪如厕的进阶版", "showIf": "skill:paid_break", "useSkill": "paid_break", "effect": { "精力": 4, "心态": 1 },
        "result": "你把这里发展成了第二个工位。比第一个舒服。" },
      { "text": "在这儿想想人生", "effect": { "心态": 1, "能力": 1 }, "result": "你想通了一件事：这一世，不能再按前世那样过了。" }
    ]
  },
  {
    "id": "d3_parking", "dir": "down", "layers": ["D3"], "weight": 12,
    "text": "地下车库很安静。一辆豪车里，副总正一个人坐着发呆。",
    "choices": [
      { "text": "敲敲车窗", "chance": 0.4, "chanceAttr": "脸皮", "chanceStep": 0.06,
        "effect": { "人脉": 4, "身价": 6 }, "result": "副总愣了，摇下车窗。你们聊了一个小时，他说你是公司里唯一敢敲他车窗的人。",
        "fail": { "effect": { "脸皮": 1 }, "result": "副总看了你一眼，把车开走了。" } },
      { "text": "绕开", "effect": { "心态": 1 }, "result": "大人物也有不想上楼的时候。你绕开了。" },
      { "text": "也找辆车坐着发呆", "absurd": true, "chance": 0.3, "chanceAttr": "心态", "chanceStep": 0.04,
        "effect": { "心态": 2, "人脉": 1 }, "result": "你坐进一辆没锁的旧车。车主是保安大叔，他递给你一个橘子。",
        "fail": { "effect": { "精力": -1 }, "result": "车主回来了。你解释了很久。" } }
    ]
  },
  {
    "id": "d3_signal", "dir": "down", "layers": ["D3"], "weight": 10,
    "text": "车库最深处没有信号。手机右上角显示「无服务」，你从来没觉得这三个字这么好看。",
    "choices": [
      { "text": "待一下午", "effect": { "心态": 2, "精力": 2, "能力": -1 }, "result": "一下午没人找到你。上楼的时候，群里多了三百条消息。" },
      { "text": "回去", "effect": { "能力": 1 }, "result": "你回到信号里。消息像雨一样砸下来。" }
    ]
  },
  {
    "id": "d4_gate", "dir": "down", "chainOnly": true,
    "text": "铁门后的机房很冷。风扇转得很响，屏幕上滚着你看不懂的字。墙角放着一把旧工椅，坐垫磨得发亮。",
    "choices": [
      { "text": "坐上去", "chance": 0.5, "chanceAttr": "心态", "chanceStep": 0.04,
        "effect": { "心态": 2, "身价": 12 }, "result": "你坐下的那一刻，屏幕上的字停了：检测到访客。欢迎回来。",
        "fail": { "effect": { "back": "down", "精力": -2 }, "result": "椅子吱呀一声塌了。你摔出了门，门在身后锁上了。" } },
      { "text": "看屏幕上的字", "effect": { "能力": 2, "身价": 6 }, "result": "你看了很久，认出了几个字：第一世、第二世、第三世……" },
      { "text": "前世认过路", "require": "legacy:way_finder>=1", "effect": { "心态": 2, "身价": 15 },
        "result": "前世你在秘境里迷过路。这一世你一眼就看出，这间机房，通着更深的地方。" }
    ]
  },
  {
    "id": "d4_server", "dir": "down", "layers": ["D4"], "weight": 10,
    "text": "机房里的服务器上贴着标签：第 0001 号宿主、第 0002 号宿主……一直排到墙尽头。",
    "choices": [
      { "text": "找自己的编号", "effect": { "心态": 1, "身价": 10 }, "result": "你找了很久，在最末尾找到了：第 6400000000 号。标签还是新的。" },
      { "text": "拔一根线试试", "absurd": true, "chance": 0.15, "chanceAttr": "脸皮", "chanceStep": 0.02,
        "effect": { "身价": 30, "心态": 1 }, "result": "灯闪了一下。远处有人喊：谁动我服务器？你赶紧插回去，兜里多了笔钱。",
        "fail": { "effect": { "death": "banned" }, "result": "天道：外挂，封了。" } },
      { "text": "什么都不碰", "effect": { "心态": 2 }, "result": "你轻轻退了出去。有些东西，现在还不是时候看。" }
    ]
  }
]
