[
  {
    "id": "s0_first_day", "dir": "up", "stage": [0, 0], "weight": 20, "once": true,
    "text": "闹钟响了。你睁开眼，看见墙上的日历——入职第一天。前世的十年，像一场很长的加班。",
    "choices": [
      { "text": "这一世，早点下班", "effect": { "心态": 1, "精力": 1 }, "result": "你给自己定了个规矩：六点关电脑。先试试。" },
      { "text": "这一世，往上爬", "effect": { "能力": 2, "身价": 2 }, "result": "你把前世踩过的坑，一个一个记在了备忘录里。" },
      { "text": "这一世，先认人", "effect": { "人脉": 2 }, "result": "谁会背锅、谁会抢功、谁是好人，你心里有一张名单。" },
      { "text": "再睡五分钟", "absurd": true, "chance": 0.3, "chanceAttr": "心态", "chanceStep": 0.05,
        "effect": { "精力": 3, "心态": 1 }, "result": "你睡了五分钟。重生的人，连赖床都很有底气。",
        "fail": { "effect": { "脸皮": 1 }, "result": "你睡了五十分钟。入职第一天，迟到了。" } }
    ]
  },
  {
    "id": "s0_badge_photo", "dir": "up", "layers": ["U1"], "stage": [0, 1], "weight": 12, "once": true,
    "text": "人事让你拍工牌照。前世这张照片，你在工牌上丑了十年。",
    "choices": [
      { "text": "认真拍", "effect": { "脸皮": 1, "人脉": 1 }, "result": "照片拍得不错。前台小姑娘多看了一眼。" },
      { "text": "随便拍", "effect": { "心态": 1 }, "result": "闭眼了。算了，反正以后也没人看。" },
      { "text": "要求重拍三次", "chance": 0.5, "chanceAttr": "脸皮", "chanceStep": 0.08,
        "effect": { "脸皮": 2, "身价": 2 }, "result": "第三张，你终于满意了。人事说：没见过这么在乎工牌的。",
        "fail": { "effect": { "心态": -1 }, "result": "人事不耐烦了：就这张。你闭着眼，丑了一辈子。" } }
    ]
  },
  {
    "id": "s0_pantry", "dir": "down", "layers": ["D1"], "stage": [0, 1], "weight": 12, "once": true,
    "text": "茶水间里有免费的咖啡、饼干和一台按摩椅。前世你一次也没坐过。",
    "choices": [
      { "text": "坐上去", "effect": { "精力": 2, "心态": 1 }, "result": "按摩椅嗡嗡地响。你闭上眼，觉得这一世有点不一样。" },
      { "text": "拿两包饼干", "effect": { "精力": 1, "身价": 1 }, "result": "你把饼干塞进抽屉。打工人的第一笔积蓄。" },
      { "text": "跟扫地阿姨聊天", "effect": { "人脉": 1, "心态": 1 }, "result": "阿姨说她在这栋楼干了二十年，什么人都见过。" }
    ]
  },
  {
    "id": "s0_group_chat", "dir": "any", "stage": [0, 1], "weight": 10, "once": true,
    "text": "你被拉进了二十几个工作群。手机震了一整天，没停过。",
    "choices": [
      { "text": "每条都回", "effect": { "人脉": 2, "精力": -1 }, "result": "你回到半夜。第二天，大家都记住了这个回消息很快的新人。" },
      { "text": "全部免打扰", "effect": { "心态": 1 }, "result": "世界安静了。你吃了一顿完整的午饭。" },
      { "text": "已读不回", "showIf": "skill:read_no_reply", "useSkill": "read_no_reply", "effect": { "心态": 2, "精力": 1 }, "result": "你看了一眼，锁屏。前世回了十年的消息，这一世不回了。" }
    ]
  },
  {
    "id": "s0_old_desk", "dir": "up", "layers": ["U1"], "stage": [0, 0], "weight": 8, "once": true,
    "text": "你的工位是上一个离职的人留下的。抽屉里有一张字条：快跑。",
    "choices": [
      { "text": "收好字条", "effect": { "心态": 1 }, "result": "你把字条夹进了笔记本。前世你没看见它。" },
      { "text": "在下面写「收到」", "effect": { "脸皮": 1, "身价": 1 }, "result": "你写完，把它放回了抽屉。留给下一个人。" },
      { "text": "去问是谁写的", "chance": 0.4, "chanceAttr": "人脉", "chanceStep": 0.08,
        "effect": { "人脉": 2, "心态": 1 }, "result": "老员工压低声音：之前那个，被老周的饼噎住了。",
        "fail": { "effect": { "脸皮": 1 }, "result": "没人承认。大家都在低头敲键盘。" } }
    ]
  }
]
