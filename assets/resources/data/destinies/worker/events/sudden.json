      { "text": "给它一根火腿肠", "chance": 0.5, "chanceAttr": "心态", "chanceStep": 0.06,
        "effect": { "心态": 1, "身价": 6 }, "result": "大猫吃完，舔了舔你的手，从窗户飞走了。前台那块地砖，从此在发光。",
        "fail": { "effect": { "精力": -2 }, "result": "它不爱吃火腿肠。它打了个喷嚏，把你吹回了工位。" } },
