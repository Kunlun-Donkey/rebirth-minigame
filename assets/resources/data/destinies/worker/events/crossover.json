[
  {
    "id": "xo_grass_desk", "careers": ["office"], "dir": "up", "layers": ["U1", "U2"], "cameo": true, "once": true, "weight": 10, "require": "xlives:desert_grass>=1",
    "text": "你工位上有一盆快干死的小草，是前一个人留下的。它的叶子，正朝着你这边歪。",
    "choices": [
