    "choices": [
      { "text": "记住那些井", "effect": { "灵性": 2, "flag": "saw_oasis" }, "result": "醒来时，你知道了荒漠西边有一口枯井。" },
      { "text": "醒过来", "effect": { "水分": 1 }, "result": "你只是一株草。草不用走路。" }
    ]
  },

  {
