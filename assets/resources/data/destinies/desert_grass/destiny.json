{
  "id": "desert_grass",
  "name": "荒漠一株草",
  "desc": "你是荒漠里的一颗草籽。这一世，你要长成贯通天地的树。",
  "attrs": [
    { "id": "water", "name": "水分", "icon": "💧", "init": 5 },
    { "id": "waterMax", "name": "水分上限", "init": 5, "hidden": true },
    { "id": "root", "name": "根系", "icon": "🌿", "init": 0 },
    { "id": "stem", "name": "茎叶", "icon": "🍃", "init": 0 },
    { "id": "tough", "name": "韧性", "icon": "🛡", "init": 0 },
    { "id": "spirit", "name": "灵性", "icon": "✨", "init": 0 },
    { "id": "qi", "name": "灵气", "icon": "🔆", "init": 0 }
  ],
  "dirs": [
    { "id": "up", "name": "向上生长" },
    { "id": "down", "name": "向下扎根" },
    { "id": "side", "name": "向旁蔓延", "require": "stage>=1" }
  ],
  "layers": [
    { "id": "U1", "dir": "up", "name": "沙面", "span": 2, "enterText": "", "blockedText": "" },
    { "id": "U2", "dir": "up", "name": "风沙层", "require": "茎叶>=3", "span": 3,
      "enterText": "你的叶尖第一次够到了风。风里有沙，也有别处的味道。", "blockedText": "你想往上够，可茎秆软得撑不住自己" },
    { "id": "U3", "dir": "up", "name": "鸟群高度", "require": "茎叶>=8", "span": 3,
      "enterText": "你长到了鸟飞过的高度。有一只鸟差点撞上你，骂骂咧咧地绕开了。", "blockedText": "再往上，风会把你折断" },
    { "id": "U4", "dir": "up", "name": "雷云", "require": "茎叶>=14", "span": 3,
      "enterText": "你的枝头碰到了云。云里有雷，在低声说话。", "blockedText": "云还很远。你还不够高" },

    { "id": "D1", "dir": "down", "name": "浮沙层", "span": 2, "enterText": "", "blockedText": "" },
    { "id": "D2", "dir": "down", "name": "湿沙层", "require": "根系>=2", "span": 2,
      "enterText": "根尖下的沙子，第一次是凉的。", "blockedText": "根太嫩，钻不动下面压实的沙" },
    { "id": "D3", "dir": "down", "name": "古河床", "require": "根系>=5", "span": 3,
      "enterText": "你碰到了圆润的鹅卵石。很久很久以前，这里流过一条河。", "blockedText": "根被一层硬土挡住了" },
    { "id": "D4", "dir": "down", "name": "沉没遗迹", "require": "根系>=8", "span": 3,
      "enterText": "根尖摸到了砖。荒漠下面，埋着一座城。", "blockedText": "下面是坚硬的岩层，根扎不进去" },
    { "id": "D5", "dir": "down", "name": "熔岩层", "require": "根系>=12", "span": 3,
      "enterText": "越往下越热。", "blockedText": "遗迹的地基太厚，根穿不过去", "enterEvent": "d5_gate" },

    { "id": "L1", "dir": "side", "name": "沙丘背面", "span": 2, "enterText": "", "blockedText": "" },
    { "id": "L2", "dir": "side", "name": "商队古道", "require": "stage>=2", "span": 3,
      "enterText": "你的根须爬过沙丘，碰到了一条被骆驼踩硬的路。", "blockedText": "沙丘太大，以你现在的身子爬不过去" },
    { "id": "L3", "dir": "side", "name": "枯萎绿洲", "require": "stage>=3 & 根系>=6", "span": 3,
      "enterText": "古道尽头，是一片死掉的绿洲。", "blockedText": "古道很长。你的根还不够长" }
  ],
  "stages": [
    { "level": 0, "name": "草籽", "narration": "", "lifespan": 14 },
    { "level": 1, "name": "嫩芽", "require": "season>=2", "lifespan": 14,
      "narration": "你破土而出。荒漠没有在意。", "bonus": { "茎叶": 1 },
      "skillPool": ["deep_dive", "photo_burst"] },
    { "level": 2, "name": "小草", "require": "灵气>=8", "lifespan": 18,
      "narration": "一只路过的甲虫看了你一眼。这是你第一次被看见。", "bonus": { "水分上限": 1, "根系": 1 },
      "skillPool": ["photo_burst", "dormancy"] },
    { "level": 3, "name": "灵草", "require": "灵气>=30 & 灵性>=3", "lifespan": 26,
      "narration": "沙漠里的风，开始绕着你走。", "bonus": { "水分上限": 2, "灵性": 1 },
      "skillPool": ["grass_soldiers", "beast_talk"] },
    { "level": 4, "name": "草精", "require": "灵气>=80 & (根系>=8 | 茎叶>=8 | 韧性>=8)", "lifespan": 40,
      "narration": "骆驼们开始做噩梦。", "bonus": { "水分上限": 3, "韧性": 2 },
      "skillPool": ["vine_bind", "swallow"] },
    { "level": 5, "name": "树妖", "require": "灵气>=180 & 根系>=12 & 茎叶>=12", "lifespan": 99,
      "narration": "荒漠第一次有了影子。",
      "endings": [ { "id": "oasis_lord", "require": "flag:oasis_alive" }, { "id": "tree_demon" } ] }
  ],
  "deaths": [
    { "id": "thirst", "icon": "thirst", "name": "渴死", "epitaph": "死于对水的思念。", "legacy": "water_cells", "skills": [ { "id": "dormancy", "chance": 0.5 } ] },
    { "id": "old_age", "icon": "old_age", "name": "寿终", "epitaph": "平平淡淡才是真。", "legacy": "old_wisdom", "skills": [ { "id": "root_net", "chance": 0.6 } ] },
    { "id": "ant", "icon": "beast", "name": "被蚂蚁搬走", "epitaph": "成为了蚁后的晚饭。", "legacy": "hard_shell", "skills": [ { "id": "play_dead", "chance": 0.5 } ] },
    { "id": "eaten_camel", "icon": "beast", "name": "被骆驼吃掉", "epitaph": "成为了骆驼的一顿早饭。", "legacy": "bitter_sap", "skills": [ { "id": "play_dead", "chance": 0.6 } ] },
    { "id": "eaten_beast", "icon": "beast", "name": "被啃了", "epitaph": "有只羚羊夸你嫩。", "legacy": "bitter_sap", "skills": [ { "id": "play_dead", "chance": 0.6 } ] },
    { "id": "sandstorm", "icon": "storm", "name": "被沙暴连根拔起", "epitaph": "第一次飞翔，也是最后一次。", "legacy": "grip_root", "skills": [ { "id": "wind_dance", "chance": 0.5 } ] },
    { "id": "scorpion", "icon": "beast", "name": "被蝎子剪断了根", "epitaph": "死在了一场打不赢的架里。", "legacy": "thorn", "skills": [ { "id": "thorn_burst", "chance": 0.5 } ] },
    { "id": "collapse", "icon": "collapse", "name": "被塌方埋了", "epitaph": "被一整条古河压在了下面。", "legacy": "hard_bark", "skills": [ { "id": "vine_bind", "chance": 0.4 } ] },
    { "id": "lava", "icon": "fire", "name": "被岩浆烤成了草干", "epitaph": "在地下一百三十七米，成为了草干。", "legacy": "fire_root", "skills": [ { "id": "lava_walk", "chance": 0.5, "require": "legacy:fire_root>=2" } ] },
    { "id": "lightning", "icon": "lightning", "name": "被雷劈了", "epitaph": "死得很亮。", "legacy": "thunder_mark", "skills": [ { "id": "thunder_call", "chance": 0.5 } ] },
    { "id": "curse", "icon": "curse", "name": "中了遗迹诅咒", "epitaph": "被三千年前的人诅咒了，冤。", "legacy": "ancient_tongue", "skills": [ { "id": "sky_eye", "chance": 0.5 } ] },
    { "id": "plucked", "icon": "human", "name": "被人类拔走", "epitaph": "被熬成了一碗草药，药效一般。", "legacy": "wariness", "skills": [ { "id": "disguise", "chance": 0.6 } ] },
    { "id": "eaten_lizard", "icon": "betrayal", "name": "被伙伴吃掉", "epitaph": "它说：对不起，太饿了。", "legacy": "judge_heart", "skills": [ { "id": "beast_talk", "chance": 0.5 } ] }
  ],
  "legacies": [
    { "id": "water_cells", "name": "储水细胞", "desc": "前世渴死过。开局水分上限提高。", "max": 5,
      "levels": [ { "水分上限": 2 }, { "水分上限": 1 }, { "水分上限": 1 }, { "水分上限": 1 }, { "水分上限": 1 } ] },
    { "id": "old_wisdom", "name": "老草的智慧", "desc": "前世寿终正寝。开局灵性提高。", "max": 3,
      "levels": [ { "灵性": 2 }, { "灵性": 1 }, { "灵性": 1 } ] },
    { "id": "hard_shell", "name": "硬壳", "desc": "前世被蚂蚁搬走过。种壳变硬了。", "max": 3,
      "levels": [ { "韧性": 1 }, { "韧性": 1 }, { "韧性": 1 } ] },
    { "id": "bitter_sap", "name": "苦涩汁液", "desc": "前世被吃过。这一世你很苦，动物会犹豫。", "max": 3,
      "levels": [ { "韧性": 1 }, {}, { "韧性": 1 } ] },
    { "id": "grip_root", "name": "抓地根", "desc": "前世被沙暴拔起过。根学会了抓紧。", "max": 5,
      "levels": [ { "根系": 1, "韧性": 1 }, { "根系": 1 }, { "根系": 1 }, { "韧性": 1 }, { "根系": 1 } ] },
    { "id": "thorn", "name": "尖刺", "desc": "前世被蝎子欺负过。这一世你长了刺。", "max": 3,
      "levels": [ { "韧性": 1 }, { "韧性": 1 }, { "韧性": 1 } ] },
    { "id": "hard_bark", "name": "硬皮", "desc": "前世被塌方埋过。皮厚了。", "max": 3,
      "levels": [ { "韧性": 2 }, { "韧性": 1 }, { "韧性": 1 } ] },
    { "id": "fire_root", "name": "耐火根", "desc": "前世被岩浆烤熟过。根记住了那种烫。Lv2 可穿越熔岩层。", "max": 3,
      "levels": [ { "根系": 1 }, { "根系": 1 }, { "根系": 2 } ] },
    { "id": "thunder_mark", "name": "雷纹", "desc": "前世被雷劈过。身上留下了雷的纹路。", "max": 3,
      "levels": [ { "灵性": 1 }, { "灵性": 1 }, { "灵性": 2 } ] },
    { "id": "ancient_tongue", "name": "古语", "desc": "前世被遗迹诅咒过。你看懂了那些字。", "max": 2,
      "levels": [ { "灵性": 2 }, { "灵性": 1 } ] },
    { "id": "wariness", "name": "警觉", "desc": "前世被人类拔走过。你学会了装成杂草。", "max": 2,
      "levels": [ { "灵性": 1 }, { "灵性": 1 } ] },
    { "id": "judge_heart", "name": "识人", "desc": "前世被伙伴吃掉过。这一世你看得清谁饿了。", "max": 2,
      "levels": [ { "灵性": 1 }, { "灵性": 1 } ] }
  ],
  "endings": [
    { "id": "tree_demon", "name": "荒漠树妖", "epitaph": "你成了荒漠里第一棵会思考的树。故事还没完，世界树还在远方。" },
    { "id": "oasis_lord", "name": "绿洲之主", "epitaph": "枯井涌水，百鸟归巢。荒漠里的生灵，都知道这片绿洲是谁的。" }
  ],
  "settings": {
    "suddenChance": 0.2,
    "rarityWeights": { "common": 60, "rare": 28, "epic": 10, "legend": 2 },
