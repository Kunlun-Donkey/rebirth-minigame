[
  {
    "id": "r_net_again", "dir": "side", "stage": [1, 99], "once": true, "weight": 12, "require": "died:net>=2",
    "text": "海面上又撒下一张网。它捞过你{died:net}回，网眼你都背得出来。",
    "choices": [
      { "text": "一拳打穿", "chance": 0.45, "chanceAttr": "拳力", "chanceStep": 0.06,
        "effect": { "拳力": 2, "海灵": 12, "feud": "渔网被你打了个窟窿" },
        "result": "你一拳打出个窟窿，一网的鱼都跟着你跑了。渔夫盯着窟窿，点了根烟。",
        "easy": "网还没收，你已经打出了三个窟窿。",
        "fail": { "effect": { "体力": -2 }, "result": "网太密，你的拳头卡在了网眼里，挣了半天。" } },
      { "text": "钻进沙里", "effect": { "打洞": 1 }, "result": "网从你头顶扫了过去。你在沙里数到一百，才出来。" },
      { "text": "帮渔夫补网", "absurd": true, "chance": 0.15, "chanceAttr": "灵性", "chanceStep": 0.02,
        "effect": { "灵性": 3, "海灵": 12, "feud": "渔夫把一网鱼倒回了海里" },
        "result": "你用钳子把网补好了。渔夫看看网，看看你，把这一网全倒回了海里。",
        "fail": { "effect": { "death": "net" }, "result": "补得很好。好到连你也捞上去了。" } }
    ]
  },
  {
    "id": "r_seagull_again", "dir": "up", "stage": [1, 99], "once": true, "weight": 12, "require": "died:seagull>=2",
    "text": "天上那只海鸥又在盘旋。它叼走过你{died:seagull}回，算准了你什么时候浮上来。",
    "choices": [
      { "text": "等它扎下来出拳", "chance": 0.4, "chanceAttr": "拳力", "chanceStep": 0.06,
        "effect": { "拳力": 2, "海灵": 12, "feud": "海鸥挨了一记直拳" },
        "result": "它扎下来的时候，你出拳了。海鸥在空中翻了三个跟头，叫声都变了。",
        "easy": "它扎下来，你出拳。干净利落，像练过一万遍。",
        "fail": { "effect": { "体力": -2 }, "result": "你打空了。它也扑空了。平局。" } },
      { "text": "沉下去", "effect": { "游速": 1 }, "result": "你沉到它看不见的地方，等它饿着肚子飞走。" },
      { "text": "跳起来抢它的鱼", "absurd": true, "chance": 0.15, "chanceAttr": "游速", "chanceStep": 0.02,
        "effect": { "海灵": 12, "体力": 3 }, "result": "你一跃出水，从它嘴里抢走了鱼。海鸥愣在半空：现在的虾都这样？",
        "fail": { "effect": { "death": "seagull" }, "result": "你跳得很高。正好跳进它嘴里。" } }
    ]
  },
  {
