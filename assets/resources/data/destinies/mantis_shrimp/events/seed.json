[
  {
    "id": "s0_siblings", "dir": "down", "stage": [0, 0], "weight": 16, "once": true, "maps": ["tidal", "reef"],
    "text": "你们一窝小虾刚孵出来，一条长满吸盘的腿从石缝里伸了进来。",
    "choices": [
      { "text": "往沙里钻", "effect": { "打洞": 1, "flag": "octopus_grudge" }, "result": "那条腿卷走了你一半的兄弟。你记住了那团紫色。" },
      { "text": "朝它挥拳", "chance": 0.4, "chanceAttr": "拳力", "chanceStep": 0.1,
        "effect": { "拳力": 2, "flag": "octopus_grudge", "follow": "f_octopus_watch" }, "result": "你的小拳头打在吸盘上，它缩了一下。章鱼墨斗，记住你了。",
        "fail": { "effect": { "体力": -2, "flag": "octopus_grudge" }, "result": "它把你甩了出去。你撞在石头上，眼冒金星。" } },
