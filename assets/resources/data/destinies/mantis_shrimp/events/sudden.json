      { "text": "前世的倒刺", "require": "legacy:thorny_tail>=1", "effect": { "feud": "老板被尾刺扎了手", "拳力": 1, "flag": "boss_seen" },
        "result": "前世你上过一次桌。这一世老板一抓，被你的尾刺扎得直甩手。" }
