[
  {
    "id": "x_rain", "dir": "any", "sudden": true, "weight": 12,
    "text": "暴雨说来就来。叶子被砸得直往下弯。",
    "choices": [
      { "text": "吐丝把自己绑住", "chance": 0.6, "chanceAttr": "吐丝", "chanceStep": 0.08,
        "effect": { "吐丝": 1 }, "result": "你被绑在叶柄上淋了一夜。雨停了，丝还在。",
        "fail": { "effect": { "death": "rain" }, "result": "丝断了。你和雨一起落了下去。" } },
      { "text": "钻进叶子卷里", "effect": { "饱腹": -1, "灵性": 1 }, "result": "你缩在卷起的叶子里。叶子抖了一夜，没掉。" },
      { "text": "前世被冲过", "require": "legacy:grip>=1", "effect": { "攀爬": 2 },
        "result": "前世这场雨冲走过你。这一世你的脚扣进了叶脉。" }
    ]
  },
  {
    "id": "x_chicken", "dir": "any", "sudden": true, "weight": 10, "maps": ["veg", "orchard"],
    "text": "一只大公鸡跳上了篱笆，歪着脖子，一只眼睛死死盯着你。",
    "choices": [
      { "text": "往菜叶底下钻", "chance": 0.5, "chanceAttr": "灵性", "chanceStep": 0.1,
        "effect": { "follow": { "id": "f_rooster_back", "delay": 2 }, "灵性": 2, "skill": "spines" }, "result": "它的嘴啄在叶子上，叶子破了。你浑身的毛都竖了起来。",
        "fail": { "effect": { "death": "chicken" }, "result": "它一口就把你啄了起来。" } },
      { "text": "竖起毒毛", "showIf": "skill:spines", "useSkill": "spines", "effect": { "吐丝": 2, "蜕变": 3 },
        "result": "它啄了一口，咳了半天，跳下篱笆走了。" },
      { "text": "前世的毒毛", "require": "legacy:bristle>=1", "effect": { "吐丝": 1, "蜕变": 3 },
        "result": "前世它啄过你。这一世它啄了一口就甩着头跑了。" }
    ]
  },
  {
    "id": "x_spray", "dir": "any", "sudden": true, "weight": 8, "stage": [1, 99], "maps": ["park", "veg"],
    "text": "背着药桶的人走过来了。喷头一甩，白雾飘了过来。",
    "choices": [
      { "text": "往风上头爬", "chance": 0.6, "chanceAttr": "灵性", "chanceStep": 0.08,
        "effect": { "灵性": 1, "攀爬": 1 }, "result": "你爬到了雾吹不到的地方。下面的蚜虫全倒了。",
        "fail": { "effect": { "death": "pesticide" }, "result": "风转了方向。" } },
      { "text": "卷成团", "showIf": "skill:curl", "useSkill": "curl", "effect": { "吐丝": 1 }, "result": "你卷成一团滚进了石缝。雾在上面飘过去了。" },
      { "text": "皮厚不怕", "require": "legacy:tough_skin>=1", "effect": { "饱腹": 1 },
        "result": "前世这股味熏倒过你。这一世你只是打了个喷嚏。" }
    ]
  },
  {
    "id": "x_kids", "dir": "any", "sudden": true, "weight": 8, "maps": ["park"],
    "text": "几个小孩发现了你，拿着树枝围了过来。",
    "choices": [
      { "text": "竖毛吓唬他们", "showIf": "skill:spines", "useSkill": "spines", "effect": { "灵性": 1 },
        "result": "一个孩子叫起来：有毒！他们一哄而散。" },
      { "text": "装死", "effect": { "follow": "f_kid_alone", "灵性": 1, "饱腹": -1 }, "result": "你一动不动。他们戳了两下，觉得没意思，走了。" },
      { "text": "往花丛爬", "chance": 0.6, "chanceAttr": "攀爬", "chanceStep": 0.1,
        "effect": { "攀爬": 2 }, "result": "你钻进了花丛。他们的树枝够不着。",
        "fail": { "effect": { "饱腹": -2 }, "result": "树枝把你挑了起来，又甩进了草里。" } }
    ]
  },
  {
    "id": "x_drought", "dir": "any", "sudden": true, "weight": 8, "stage": [1, 99],
    "text": "一个多月没下雨。叶子边都卷起来了，嚼着像纸。",
    "choices": [
      { "text": "省着吃", "effect": { "饱腹": -1, "灵性": 1 }, "result": "你每天只啃一小口。饿，但还活着。" },
      { "text": "去找嫩叶", "chance": 0.5, "chanceAttr": "攀爬", "chanceStep": 0.08,
        "effect": { "饱腹": 3 }, "result": "你在树荫最深处找到了几片还绿着的叶子。",
        "fail": { "effect": { "饱腹": -2 }, "result": "爬了一天，全是干叶子。" } }
    ]
  },
  {
    "id": "x_cocoon", "dir": "any", "sudden": true, "weight": 14, "stage": [3, 3], "once": true,
    "text": "茧里又暖又黑。你很困，困得想一直睡到明年。",
    "choices": [
      { "text": "按时醒来", "effect": { "蜕变": 5, "灵性": 1 }, "result": "你咬开茧的一角。外面的光有点刺眼。" },
      { "text": "再睡一会儿", "chance": 0.6, "chanceAttr": "灵性", "chanceStep": 0.05,
        "effect": { "蜕变": 12 }, "result": "你睡了个好觉。醒来时，身体里多了一对东西。",
        "fail": { "effect": { "death": "no_wake" }, "result": "你睡得太沉了。" } },
      { "text": "前世睡过头", "require": "legacy:patience>=1", "effect": { "蜕变": 12, "吐丝": 1 },
        "result": "前世你在这儿睡过了一辈子。这一世你掐着时辰醒了。" }
    ]
  },
  {
    "id": "x_magpie_old", "dir": "any", "sudden": true, "weight": 14, "stage": [3, 99], "once": true, "require": "flag:magpie_grudge",
    "text": "花胸喜鹊落在你旁边的树枝上。它在找吃的，啄了半天没啄到一只虫。",
    "choices": [
      { "text": "亮出它的尾羽", "require": "item:magpie_feather", "effect": { "蜕变": 10, "灵性": 2 },
        "result": "它看见自己的羽毛，愣住了。然后它低着头飞走了。" },
      { "text": "躲着它", "effect": { "灵性": 1 }, "result": "它没看见你。你也没让它看见。" },
      { "text": "扔片叶子给它", "effect": { "灵性": 3, "蜕变": 3 }, "result": "它看看叶子，又看看你，不明白。你也不需要它明白。" }
    ]
  },
  {
    "id": "x_granny_end", "dir": "any", "sudden": true, "weight": 18, "stage": [4, 99], "once": true, "require": "flag:granny_seen", "maps": ["veg"],
    "text": "老太太又来捉虫了。她弯着腰，看见了你——一只落在白菜上的大蝴蝶。",
    "choices": [
      { "text": "冲她点点头", "effect": { "ending": "garden_boss" }, "result": "老太太手一抖，菜篮子掉了。" },
      { "text": "飞走", "effect": { "攀爬": 2, "蜕变": 5 }, "result": "她直起腰看着你飞远，嘟囔了一句：今年的蝴蝶真大。" }
    ]
  },
  {
    "id": "x_eclipse", "dir": "any", "sudden": true, "gold": true, "stage": [2, 99], "weight": 2,
    "text": "大白天，太阳一点点黑了。所有的虫子都停下了嘴。",
    "choices": [
      { "text": "朝太阳爬", "effect": { "蜕变": 15, "灵性": 2 }, "result": "太阳回来的那一刻，第一道光正好落在你身上。" },
      { "text": "趁乱多吃几口", "effect": { "饱腹": 4, "胃口": 3 }, "result": "大家都在发呆，整片叶子都是你的。" }
    ]
  },
  {
    "id": "x_ancient_cocoon", "dir": "any", "sudden": true, "gold": true, "stage": [2, 99], "weight": 2, "once": true,
    "text": "树皮裂缝里，嵌着一个石头一样的旧茧。茧上的纹路，你好像在梦里见过。",
    "choices": [
      { "text": "把它抠出来", "effect": { "item": "ancient_cocoon" }, "result": "茧很轻。里面那只蝴蝶，很久以前就飞走了。" },
      { "text": "在旁边结茧", "effect": { "吐丝": 3, "灵性": 2 }, "result": "你挨着它结了茧。睡着时，你梦见了一片很大的天。" }
    ]
  }
]
