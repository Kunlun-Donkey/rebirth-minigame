[
  {
    "id": "up_fallback", "dir": "up", "weight": 3,
    "text": "你一节一节往上拱，拱了一整季。",
    "choices": [ { "text": "继续拱", "effect": { "攀爬": 1 }, "result": "没遇到什么事。这就是好事。" } ]
  },

  {
    "id": "u1_climb", "dir": "up", "layers": ["U1"], "weight": 12,
    "text": "叶尖翘得老高，你想爬上去看看外面。",
    "choices": [
      { "text": "爬上去", "chance": 0.6, "chanceAttr": "攀爬", "chanceStep": 0.1,
        "effect": { "follow": "f_tip_wind", "攀爬": 2, "蜕变": 1 }, "result": "你挂在叶尖上晃了晃。外面的世界，绿得发亮。",
        "fail": { "effect": { "饱腹": -1 }, "result": "爬到一半滑了下来，摔回叶心，晕了一下午。" } },
      { "text": "先吃饱再说", "effect": { "饱腹": 2 }, "result": "你把叶尖啃掉了。这下不用爬了。" }
    ]
  },
  {
    "id": "u1_rain", "dir": "up", "layers": ["U1"], "weight": 10,
    "text": "天黑下来了。第一颗雨点砸在叶子上，跟砸了块石头一样。",
    "choices": [
      { "text": "躲回叶背", "effect": { "胃口": 1 }, "result": "你缩在叶背听了一夜雨。顺便把叶背也啃了。" },
      { "text": "迎着雨抓紧", "chance": 0.5, "chanceAttr": "吐丝", "chanceStep": 0.1,
        "effect": { "follow": "f_wet_bee", "攀爬": 2, "skill": "silk_rope" }, "result": "你吐了根丝把自己绑在叶柄上。雨停了，你还在。",
        "fail": { "effect": { "death": "rain" }, "result": "一颗大雨点把你从叶子上砸了下去。" } },
      { "text": "前世被冲过", "require": "legacy:grip>=1", "effect": { "follow": "f_wet_bee", "攀爬": 2, "吐丝": 1 },
        "result": "前世一场雨冲走了你。这一世你的脚抓得比树皮还紧。" }
    ]
  },
  {
    "id": "u1_sun", "dir": "up", "layers": ["U1", "U2"], "stage": [1, 99], "weight": 10,
    "text": "太阳照在叶尖上，暖得你直犯困。",
    "choices": [
      { "text": "晒个够", "effect": { "蜕变": 2, "饱腹": -1 }, "result": "你晒得浑身发烫。身体里有什么东西在长。" },
      { "text": "躲进阴凉", "effect": { "饱腹": 1 }, "result": "你在阴凉里睡了一觉，饿劲小了点。" }
    ]
  },

  {
    "id": "u2_swing", "dir": "up", "layers": ["U2"], "weight": 12,
    "text": "风一吹，树枝就荡秋千。你也跟着荡。",
    "choices": [
      { "text": "吐丝荡过去", "chance": 0.5, "chanceAttr": "吐丝", "chanceStep": 0.1,
        "effect": { "攀爬": 2, "吐丝": 1 }, "result": "你吊着一根丝荡到了另一根树枝上。风是你的了。",
        "fail": { "effect": { "饱腹": -2 }, "result": "丝断了。你在半空转了三圈，挂在一片叶子上。" } },
      { "text": "抱紧树枝", "effect": { "攀爬": 1 }, "result": "你抱着树枝荡了一天。头有点晕，脚有点酸。" }
    ]
  },
  {
    "id": "u2_spider", "dir": "up", "layers": ["U2", "U3"], "weight": 10,
    "text": "你一头撞进了蜘蛛网。网那头，八只眼睛亮了。",
    "choices": [
      { "text": "拼命挣开", "chance": 0.5, "chanceAttr": "吐丝", "chanceStep": 0.1,
        "effect": { "follow": { "id": "f_spider_grudge", "delay": 2 }, "吐丝": 2 }, "result": "你扯断了三根丝逃了出来。原来丝还能这么用。",
        "fail": { "effect": { "饱腹": -2, "吐丝": 1 }, "result": "你越挣越紧，最后是一阵风把网吹破的。" } },
      { "text": "跟它商量", "showIf": "skill:talk", "useSkill": "talk", "effect": { "灵性": 1, "蜕变": 3 },
        "result": "蜘蛛听完你的话，笑了。它说你太扎嘴，放你走了。" },
      { "text": "不动，装死", "effect": { "灵性": 1, "饱腹": -1 }, "result": "你一动不动挂了半天。蜘蛛觉得你不新鲜，把你剪了下去。" }
    ]
  },
  {
    "id": "u2_beans", "dir": "up", "layers": ["U2"], "maps": ["veg"], "weight": 14,
    "text": "豆角架上挂满了嫩豆角，一根比你长十倍。",
    "choices": [
      { "text": "钻进豆角", "effect": { "follow": "f_bean_pick", "饱腹": 3, "胃口": 1 }, "result": "你在豆角里吃出了一条隧道。豆子比叶子香。" },
      { "text": "爬到架子顶", "effect": { "攀爬": 2 }, "result": "你爬到了竹竿顶上，看见了整个菜园。" }
    ]
  },
  {
    "id": "u2_lamp", "dir": "up", "layers": ["U2"], "maps": ["park"], "weight": 14,
    "text": "天黑了，路灯亮了。一群飞蛾绕着灯转，像在赶集。",
    "choices": [
      { "text": "爬上去看看", "chance": 0.6, "chanceAttr": "灵性", "chanceStep": 0.1,
        "effect": { "灵性": 2, "蜕变": 2 }, "result": "一只老飞蛾告诉你：长了翅膀，别往火上撞。",
        "fail": { "effect": { "饱腹": -2 }, "result": "灯太烫了。你在杆子上烫红了三只脚。" } },
      { "text": "躲在杆子背面", "effect": { "攀爬": 1 }, "result": "你在暗处看着它们转了一夜。你决定以后不这样。" }
    ]
  },

  {
    "id": "u3_nest", "dir": "up", "layers": ["U3"], "weight": 10,
    "text": "鸟窝里三只雏鸟张着黄嘴叫唤。大鸟不在家。",
    "choices": [
      { "text": "快爬过去", "chance": 0.6, "chanceAttr": "攀爬", "chanceStep": 0.08,
        "effect": { "攀爬": 2, "蜕变": 3 }, "result": "你从窝边溜了过去。雏鸟冲你叫，叫得很饿。",
        "fail": { "effect": { "death": "bird" }, "result": "大鸟回来了。它没让孩子饿着。" } },
      { "text": "退回枝头", "effect": { "follow": "f_nestling", "back": "up", "灵性": 1 }, "result": "你退了回去。今天不是好日子。" }
    ]
  },
  {
    "id": "u3_magpie", "dir": "up", "layers": ["U2", "U3"], "stage": [1, 3], "weight": 12, "require": "flag:magpie_grudge",
    "text": "胸口有白斑的那只喜鹊又来了。它歪头盯着你，像在认人。",
    "choices": [
      { "text": "钻进树皮缝", "chance": 0.5, "chanceAttr": "灵性", "chanceStep": 0.1,
        "effect": { "follow": { "id": "f_magpie_wait", "delay": 2 }, "灵性": 2 }, "result": "它的喙在缝口敲了三下，走了。你又躲过一次。",
        "fail": { "effect": { "death": "bird" }, "result": "缝太浅了。花胸叼起你，飞走了。" } },
      { "text": "竖起毒毛", "showIf": "skill:spines", "useSkill": "spines", "effect": { "follow": "f_magpie_laugh", "吐丝": 2, "蜕变": 4 },
        "result": "它一口啄下去，又一口吐出来，满嘴是毛。它恨恨地飞走了。" },
      { "text": "前世的毒毛", "require": "legacy:bristle>=2", "effect": { "follow": "f_magpie_laugh", "吐丝": 2, "蜕变": 3 },
        "result": "前世它啄过你。这一世你的毛扎得它直甩头。" },
      { "text": "往下掉", "effect": { "back": "up", "饱腹": -1 }, "result": "你松开脚，掉回了下面一层。它没追。" }
    ]
  },
  {
    "id": "u3_revenge", "dir": "up", "layers": ["U3", "U4"], "stage": [4, 99], "once": true, "weight": 25, "require": "flag:magpie_grudge",
    "text": "你有了翅膀。那只花胸喜鹊落在旁边，没认出你。它老了，白斑灰了。",
    "choices": [
      { "text": "撒它一脸鳞粉", "showIf": "skill:dust", "useSkill": "dust", "effect": { "item": "magpie_feather", "蜕变": 10 },
        "result": "它眯着眼乱扑，一根尾羽落下来。你捡走了它。" },
      { "text": "落在它头上", "chance": 0.5, "chanceAttr": "攀爬", "chanceStep": 0.05,
        "effect": { "蜕变": 8, "灵性": 2 }, "result": "你在它头顶站了一会儿。它到死都不知道是谁。",
        "fail": { "effect": { "饱腹": -2 }, "result": "它扑了一下，你吓得飞走了。旧账还在。" } },
      { "text": "算了", "effect": { "灵性": 3 }, "result": "你飞走了。不是原谅，是它不配。" }
    ]
  },
  {
    "id": "u3_view", "dir": "up", "layers": ["U3"], "weight": 8, "gold": true,
    "text": "你在树冠上看见了远处的山。山坳里飞着一片彩色的云。",
    "choices": [
      { "text": "盯着看", "effect": { "follow": { "id": "f_valley_wind", "delay": 2 }, "灵性": 3, "蜕变": 3 }, "result": "那不是云，是蝴蝶。你第一次知道自己想去哪儿。" },
      { "text": "继续啃叶", "effect": { "饱腹": 2, "胃口": 1 }, "result": "远方再好，叶子也得先吃。" }
    ]
  },

  {
    "id": "u4_storm_wing", "dir": "up", "layers": ["U4"], "stage": [4, 99], "once": true, "weight": 20,
    "text": "树顶的风很大。你张开翅膀，风从翅膀下面钻了过去。",
    "choices": [
      { "text": "用力扇一下", "effect": { "蜕变": 10, "flag": "storm_wing" }, "result": "风变了方向。远处的云，跟着拐了个弯。" },
      { "text": "收起翅膀", "effect": { "饱腹": 2 }, "result": "你躲在叶子下面等风停。还不是时候。" }
    ]
  },
  {
    "id": "u4_thunder", "dir": "up", "layers": ["U4"], "stage": [3, 99], "weight": 12,
    "text": "雷云压到了树顶。一道闪电，劈断了旁边的树枝。",
    "choices": [
      { "text": "迎着雷飞", "chance": 0.4, "chanceAttr": "灵性", "chanceStep": 0.05,
        "effect": { "蜕变": 15, "item": "thunder_silk" }, "result": "雷擦着你的翅膀过去，在你吐的丝上留了一道光。",
        "fail": { "effect": { "death": "lightning" }, "result": "你被雷追上了。" } },
      { "text": "躲进叶堆", "effect": { "灵性": 1 }, "result": "你缩在叶子里数了一夜的雷。" },
      { "text": "翅上有雷纹", "require": "legacy:thunder_mark>=1", "effect": { "蜕变": 20, "灵性": 2 },
        "result": "前世雷劈过你。这一世雷绕着你走。" }
    ]
  },
  {
    "id": "u4_sky", "dir": "up", "layers": ["U4"], "weight": 8, "gold": true,
    "text": "天特别蓝。一只老凤蝶落在树顶，打量着你。",
    "choices": [
      { "text": "请它指点", "effect": { "follow": { "id": "f_swallowtail", "delay": 3, "ttl": 6 }, "灵性": 2, "攀爬": 2, "蜕变": 5 }, "result": "它说：飞的时候别想着怎么飞。说完就飞走了。" },
      { "text": "跟它比高", "chance": 0.4, "chanceAttr": "攀爬", "chanceStep": 0.05,
        "effect": { "攀爬": 4, "蜕变": 8 }, "result": "你比它高了一片叶子。它笑了，留下一点花粉。",
        "fail": { "effect": { "饱腹": -2 }, "result": "你累得趴在树顶。它早飞没影了。" } }
    ]
  }
]
